@model IsoDof.Web.Models.DashboardViewModel

@{
    ViewData["Title"] = "Kalite Kontrol & DÖF";
    var roleDisplayName = User.IsInRole("Admin") ? "Sistem Yöneticisi" :
                         (User.IsInRole("KaliteKontrol") ? "Kalite Sorumlusu" : "Çalışan");
    var totalDofs = Model.TotalCount > 0 ? Model.TotalCount : 1;
    var openRate = Math.Round((double)Model.OpenCount / totalDofs * 100);
    var closedRate = Math.Round((double)Model.ClosedCount / totalDofs * 100);
}

<!-- BAŞLIK ÇUBUĞU: BAŞLIK & ÜST İŞLEMLER -->
<div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold tracking-tight text-white">Kalite Kontrol &amp; DÖF</h1>
        <p class="text-xs text-on-surface-variant mt-1">
            Anlık uygunsuzluk takibi ve ISO uyum izleme •
            <span class="text-primary font-medium">@Model.UserFullName</span>
            @if (!string.IsNullOrEmpty(Model.DepartmentName))
            {
                <span>(@Model.DepartmentName)</span>
            }
        </p>
    </div>
    <div class="flex items-center gap-3">
        <a asp-controller="Dofs" asp-action="ExportExcel" class="flex items-center gap-2 bg-surface-container-low hover:bg-white/[0.04] text-on-surface border border-white/[0.08] px-3.5 py-2 rounded-lg text-xs font-medium transition-colors">
            <span class="material-symbols-outlined text-[1.125rem] text-outline">file_download</span>
            <span>Özeti Dışa Aktar</span>
        </a>
        @if (!User.IsInRole("Admin") && !User.IsInRole("KaliteKontrol"))
        {
            <a asp-controller="Dofs" asp-action="Create" class="flex items-center gap-2 bg-primary hover:bg-primary-container text-on-primary px-4 py-2 rounded-lg text-xs font-semibold shadow-sm transition-all">
                <span class="material-symbols-outlined text-[1.125rem]">add</span>
                <span>Yeni DÖF</span>
            </a>
        }
    </div>
</div>

<!-- 3 TEMEL METRİK KARTI -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-5">
    <!-- Kart 1: Açık DÖF'ler -->
    <div class="bg-surface-container-low rounded-xl p-5 border border-white/[0.06] flex flex-col justify-between hover:border-white/[0.12] transition-colors shadow-sm">
        <div class="flex items-center justify-between">
            <span class="text-xs font-medium text-on-surface-variant">Açık DÖF'ler</span>
            <span class="text-[0.6875rem] font-medium font-mono text-primary bg-primary/10 border border-primary/20 px-2 py-0.5 rounded-full">
                %@openRate Açık
            </span>
        </div>
        <div class="mt-4 flex items-baseline gap-3">
            <span class="text-3xl font-bold tracking-tight text-white">@Model.OpenCount</span>
            <span class="text-xs text-on-surface-variant">
                @Model.TotalCount toplam · @Model.ClosedCount kapatıldı
            </span>
        </div>
    </div>

    <!-- Kart 2: Dikkat Gerektiren / Gecikmiş -->
    <div class="bg-surface-container-low rounded-xl p-5 border border-white/[0.06] flex flex-col justify-between hover:border-white/[0.12] transition-colors shadow-sm">
        <div class="flex items-center justify-between">
            <span class="text-xs font-medium text-on-surface-variant">Dikkat Gerektiren</span>
            @if (Model.OverdueCount > 0)
            {
                <span class="text-[0.6875rem] font-medium font-mono text-amber-400 bg-amber-400/10 border border-amber-400/20 px-2 py-0.5 rounded-full animate-pulse">
                    İnceleme Bekliyor
                </span>
            }
            else
            {
                <span class="text-[0.6875rem] font-medium font-mono text-tertiary bg-tertiary/10 border border-tertiary/20 px-2 py-0.5 rounded-full">
                    Sorun Yok
                </span>
            }
        </div>
        <div class="mt-4 flex items-baseline gap-3">
            <span class="text-3xl font-bold tracking-tight @(Model.OverdueCount > 0 ? "text-amber-400" : "text-white")">
                @Model.OverdueCount
            </span>
            <span class="text-xs text-on-surface-variant">
                @(Model.OverdueCount > 0 ? "Gecikmiş kök neden veya faaliyet" : "Gecikmiş kayıt yok")
            </span>
        </div>
    </div>

    <!-- Kart 3: Zamanında Kapatma Oranı -->
    <div class="bg-surface-container-low rounded-xl p-5 border border-white/[0.06] flex flex-col justify-between hover:border-white/[0.12] transition-colors shadow-sm">
        <div class="flex items-center justify-between">
            <span class="text-xs font-medium text-on-surface-variant">Zamanında Kapatma Oranı</span>
            <span class="text-[0.6875rem] font-medium font-mono text-tertiary bg-tertiary/10 border border-tertiary/20 px-2 py-0.5 rounded-full">
                Hedefe Ulaşıldı
            </span>
        </div>
        <div class="mt-4 flex items-baseline gap-3">
            <span class="text-3xl font-bold tracking-tight text-white">%@closedRate</span>
            <span class="text-xs text-on-surface-variant">@Model.ClosedCount doğrulanıp kapatıldı</span>
        </div>
    </div>
</div>

<!-- ANA İKİ KOLONLU YERLEŞİM -->
<div class="grid grid-cols-1 xl:grid-cols-12 gap-6 items-start">
    <!-- SOL KOLON: DÖF KAYITLARI TABLOSU (8 Kolon) -->
    <div class="xl:col-span-8 bg-surface-container-low rounded-xl border border-white/[0.06] overflow-hidden shadow-sm">
        <!-- Tablo Arama & Filtre Çubuğu -->
        <div class="p-5 border-b border-white/[0.06] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
                <h2 class="text-base font-semibold text-white">Açık Uygunsuzluklar</h2>
                <p class="text-xs text-on-surface-variant mt-0.5">Aksiyon bekleyen @Model.UrgentDofs.Count öncelikli kayıt gösteriliyor</p>
            </div>
            <div class="flex items-center gap-2">
                <div class="relative">
                    <span class="material-symbols-outlined absolute left-2.5 top-1/2 -translate-y-1/2 text-outline text-[1rem]">search</span>
                    <input class="bg-surface-container border border-white/[0.08] rounded-lg pl-8 pr-3 py-1 text-xs text-on-surface placeholder:text-outline focus:outline-none focus:border-primary/40 w-48"
                           id="capaSearchInput" placeholder="Kayıtlarda filtrele..." type="text" />
                </div>
                <a asp-controller="Dofs" asp-action="Index" class="p-1.5 rounded-lg border border-white/[0.08] bg-surface-container text-on-surface-variant hover:text-white transition-colors" title="Tüm filtreleri gör">
                    <span class="material-symbols-outlined text-[1.125rem]">tune</span>
                </a>
            </div>
        </div>

        <!-- Yoğun Tablo -->
        <div class="overflow-x-auto">
            @if (!Model.UrgentDofs.Any())
            {
                <div class="py-12 px-4 text-center text-on-surface-variant text-xs">
                    <span class="material-symbols-outlined text-2xl text-tertiary block mb-1">verified</span>
                    Harika! Şu an inceleme bekleyen acil DÖF kaydı bulunmuyor.
                </div>
            }
            else
            {
                <table class="w-full text-left text-xs">
                    <thead>
                        <tr class="border-b border-white/[0.06] text-on-surface-variant font-medium">
                            <th class="py-3.5 px-5 font-normal">DÖF No</th>
                            <th class="py-3.5 px-4 font-normal">Başlık &amp; Açıklama</th>
                            <th class="py-3.5 px-4 font-normal">Önem</th>
                            <th class="py-3.5 px-4 font-normal">Departman</th>
                            <th class="py-3.5 px-4 font-normal">Durum / Termin</th>
                            <th class="py-3.5 px-5 text-right font-normal">İşlem</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-white/[0.04]">
                        @foreach (var dof in Model.UrgentDofs)
                        {
                            <tr class="hover:bg-white/[0.02] transition-colors group">
                                <td class="py-4 px-5 font-mono font-medium text-primary whitespace-nowrap">
                                    <a asp-controller="Dofs" asp-action="Details" asp-route-id="@dof.Id" class="hover:underline">
                                        DÖF-@dof.Id.ToString("D3")
                                    </a>
                                </td>
                                <td class="py-4 px-4 max-w-xs">
                                    <a asp-controller="Dofs" asp-action="Details" asp-route-id="@dof.Id" class="font-medium text-white group-hover:text-primary transition-colors truncate block">
                                        @dof.Title
                                    </a>
                                    <div class="text-[0.6875rem] text-on-surface-variant truncate mt-0.5">
                                        @dof.Description
                                    </div>
                                </td>
                                <td class="py-4 px-4 whitespace-nowrap">
                                    @if (dof.IsOverdue)
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[0.6875rem] font-medium bg-red-500/10 text-red-400 border border-red-500/20">
                                            Kritik
                                        </span>
                                    }
                                    else if (dof.Type == IsoDof.Web.Models.Entities.Enums.DofType.Duzeltici)
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[0.6875rem] font-medium bg-amber-500/10 text-amber-400 border border-amber-500/20">
                                            Yüksek
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[0.6875rem] font-medium bg-blue-500/10 text-blue-400 border border-blue-500/20">
                                            Orta
                                        </span>
                                    }
                                </td>
                                <td class="py-4 px-4 text-on-surface-variant whitespace-nowrap">
                                    @(dof.Department?.Name ?? "-")
                                </td>
                                <td class="py-4 px-4 whitespace-nowrap">
                                    @if (dof.IsOverdue)
                                    {
                                        <div class="text-red-400 font-medium text-[0.6875rem]">Gecikmiş (@(dof.DueDate?.ToString("dd.MM") ?? "-"))</div>
                                        <div class="text-[0.6875rem] text-on-surface-variant mt-0.5">@dof.Status</div>
                                    }
                                    else
                                    {
                                        <div class="text-white font-medium text-[0.6875rem]">@(dof.DueDate?.ToString("dd.MM.yyyy") ?? "—")</div>
                                        <div class="text-[0.6875rem] text-on-surface-variant mt-0.5">@dof.Status</div>
                                    }
                                </td>
                                <td class="py-4 px-5 text-right whitespace-nowrap">
                                    <a asp-controller="Dofs" asp-action="Details" asp-route-id="@dof.Id"
                                       class="text-xs font-medium text-primary hover:text-primary-container px-2.5 py-1 rounded-md hover:bg-primary/10 transition-colors">
                                        İncele
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <!-- Sayfalama -->
        <div class="p-4 border-t border-white/[0.06] flex items-center justify-between text-xs text-on-surface-variant">
            <span>@Model.TotalCount kayıttan @Model.UrgentDofs.Count tanesi gösteriliyor</span>
            <div class="flex items-center gap-1">
                <a asp-controller="Dofs" asp-action="Index" class="px-3 py-1 rounded hover:bg-white/[0.04] text-primary transition-colors text-xs font-medium">
                    Tüm Kayıtları Gör →
                </a>
            </div>
        </div>
    </div>

    <!-- SAĞ KOLON: SON HAREKETLER ZAMAN ÇİZELGESİ (4 Kolon) -->
    <div class="xl:col-span-4 bg-surface-container-low rounded-xl border border-white/[0.06] p-5 flex flex-col gap-5 shadow-sm">
        <div class="flex items-center justify-between">
            <h2 class="text-base font-semibold text-white">Son Hareketler</h2>
            <span class="text-[0.6875rem] text-on-surface-variant font-mono">Denetim İzi</span>
        </div>

        <!-- Hareket Öğeleri -->
        <div class="flex flex-col gap-4">
            @if (Model.RecentDofs.Any())
            {
                @foreach (var dof in Model.RecentDofs.Take(3))
                {
                    <div class="flex items-start gap-3.5 pb-3.5 border-b border-white/[0.04] last:border-b-0 last:pb-0">
                        <div class="w-8 h-8 rounded-full @(dof.Status == IsoDof.Web.Models.Entities.Enums.DofStatus.Kapatildi ? "bg-tertiary/10 border-tertiary/20 text-tertiary" : (dof.IsOverdue ? "bg-red-500/10 border-red-500/20 text-red-400" : "bg-primary/10 border-primary/20 text-primary")) border flex items-center justify-center shrink-0 mt-0.5">
                            <span class="material-symbols-outlined text-[1rem]">
                                @(dof.Status == IsoDof.Web.Models.Entities.Enums.DofStatus.Kapatildi ? "check" : (dof.IsOverdue ? "warning" : "edit_document"))
                            </span>
                        </div>
                        <div class="flex flex-col flex-1 min-w-0">
                            <div class="flex items-center justify-between gap-2">
                                <a asp-controller="Dofs" asp-action="Details" asp-route-id="@dof.Id" class="text-xs font-medium text-white truncate hover:underline">
                                    @dof.Title
                                </a>
                                <span class="text-[0.6875rem] text-on-surface-variant shrink-0">@dof.CreatedAt.ToString("dd.MM")</span>
                            </div>
                            <p class="text-xs text-on-surface-variant mt-0.5 leading-relaxed">
                                <strong class="text-on-surface">@(dof.CreatedByUser?.FullName ?? "Çalışan")</strong>,
                                @(dof.Department?.Name ?? "Genel") için
                                <span class="font-mono text-primary text-[0.6875rem]">DÖF-@dof.Id.ToString("D3")</span> kaydını oluşturdu.
                            </p>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-xs text-on-surface-variant py-4 text-center">
                    Henüz aktivite kaydı bulunmuyor.
                </div>
            }
        </div>

        <a asp-controller="DofActions" asp-action="Index" class="w-full py-2 px-3 text-center rounded-lg border border-white/[0.06] hover:bg-white/[0.03] text-xs font-medium text-on-surface-variant hover:text-white transition-colors mt-1">
            Faaliyetler &amp; Denetimler
        </a>
    </div>
</div>

@section Scripts {
    <script>
        // Basit tablo filtresi
        document.getElementById('capaSearchInput')?.addEventListener('input', function (e) {
            const val = e.target.value.toLowerCase();
            const rows = document.querySelectorAll('tbody tr');
            rows.forEach(row => {
                row.style.display = row.innerText.toLowerCase().includes(val) ? '' : 'none';
            });
        });
    </script>
}
