@model IEnumerable<IsoDof.Web.Models.Entities.Department>

@{
    ViewData["Title"] = "Departmanlar";
}

<h1>Departmanlar</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Yeni Departman</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Ad</th>
            <th>Kod</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var dept in Model)
        {
            <tr>
                <td>@dept.Name</td>
                <td>@dept.Code</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@dept.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                    <a asp-action="Delete" asp-route-id="@dept.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>