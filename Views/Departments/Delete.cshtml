@model IsoDof.Web.Models.Entities.Department

@{
    ViewData["Title"] = "Departman Sil";
}

<h1>Departman Sil</h1>

<h3>Bu departmanı silmek istediğine emin misin?</h3>

<div>
    <dl class="row">
        <dt class="col-sm-2">Ad</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Kod</dt>
        <dd class="col-sm-10">@Model.Code</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Evet, Sil</button>
        <a asp-action="Index" class="btn btn-secondary">Vazgeç</a>
    </form>
</div>