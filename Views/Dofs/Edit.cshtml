@model IsoDof.Web.Models.Entities.Dof

@{
    ViewData["Title"] = $"DÖF-#{Model.Id:D4} Düzenle";
}

<div class="max-w-5xl mx-auto pb-24 text-on-surface">
    <!-- HEADER -->
    <header class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 bg-surface-container-low p-space-md rounded-2xl border border-outline-variant/20 shadow-md">
        <div>
            <div class="flex items-center gap-3 mb-1">
                <div class="flex items-center gap-2">
                    <a asp-action="Details" asp-route-id="@Model.Id" class="font-code-sm text-xs text-outline hover:text-primary transition-colors flex items-center gap-1">
                        <span class="material-symbols-outlined text-sm">arrow_back</span>
                        <span>DÖF Detayına Dön</span>
                    </a>
                    <span class="text-outline/40">/</span>
                    <h1 class="font-headline-xl text-xl font-bold text-on-surface tracking-tight">DÖF Kaydını Güncelle</h1>
                </div>
                <span class="px-2.5 py-0.5 rounded-md bg-surface-container border border-outline-variant/30 text-primary font-code-sm text-xs font-semibold">
                    #DÖF-@Model.Id.ToString("D4")
                </span>
            </div>
            <p class="font-body-sm text-xs text-on-surface-variant">
                DÖF durumunu, termin tarihini veya atanan sorumluyu bu ekrandan güncelleyebilirsiniz.
            </p>
        </div>

        <span class="px-3 py-1 rounded-lg text-xs font-semibold font-code-sm border
              @(Model.Status == IsoDof.Web.Models.Entities.Enums.DofStatus.Kapatildi ? "bg-tertiary/10 text-tertiary border-tertiary/30" :
                (Model.Status == IsoDof.Web.Models.Entities.Enums.DofStatus.Reddedildi ? "bg-error/10 text-error border-error/30" :
                 "bg-primary/10 text-primary border-primary/30"))">
            Mevcut: @Model.Status
        </span>
    </header>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
    {
        <div class="mb-6 p-4 rounded-xl bg-error-container/20 border border-error/30 text-error text-xs flex flex-col gap-1">
            <div class="font-bold flex items-center gap-1">
                <span class="material-symbols-outlined text-base">error</span>
                <span>Lütfen formdaki eksik veya hatalı alanları düzeltiniz:</span>
            </div>
            <div asp-validation-summary="ModelOnly" class="pl-5 text-on-surface"></div>
        </div>
    }

    <!-- FORM -->
    <form asp-action="Edit" method="post" class="flex flex-col gap-6">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="bg-surface-container-low border border-outline-variant/20 rounded-2xl p-6 shadow-sm flex flex-col gap-5">
            <div>
                <label class="block font-label-md text-xs font-semibold text-on-surface mb-2 uppercase tracking-wider" asp-for="Title">
                    Uygunsuzluk Başlığı <span class="text-error">*</span>
                </label>
                <input asp-for="Title" class="w-full bg-surface-container border border-outline-variant/40 px-4 py-2.5 rounded-xl text-on-surface font-body-md text-sm focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/30 transition-all" required />
                <span asp-validation-for="Title" class="text-error text-xs mt-1 block"></span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div>
                    <label class="block font-label-md text-xs text-on-surface-variant mb-1.5 font-medium uppercase tracking-wider" asp-for="Status">
                        DÖF Durumu <span class="text-error">*</span>
                    </label>
                    <div class="relative">
                        <select asp-for="Status" asp-items="Html.GetEnumSelectList<IsoDof.Web.Models.Entities.Enums.DofStatus>()"
                                class="w-full bg-surface-container border border-outline-variant/40 text-on-surface text-xs rounded-xl px-3 py-2.5 appearance-none focus:outline-none focus:border-primary transition-all font-semibold text-primary">
                        </select>
                        <span class="pointer-events-none absolute right-2.5 top-2.5 material-symbols-outlined text-outline text-base">expand_more</span>
                    </div>
                    <span asp-validation-for="Status" class="text-error text-xs mt-1 block"></span>
                </div>

                <div>
                    <label class="block font-label-md text-xs text-on-surface-variant mb-1.5 font-medium uppercase tracking-wider" asp-for="Type">
                        Faaliyet Türü <span class="text-error">*</span>
                    </label>
                    <div class="relative">
                        <select asp-for="Type" asp-items="Html.GetEnumSelectList<IsoDof.Web.Models.Entities.Enums.DofType>()"
                                class="w-full bg-surface-container border border-outline-variant/40 text-on-surface text-xs rounded-xl px-3 py-2.5 appearance-none focus:outline-none focus:border-primary transition-all">
                        </select>
                        <span class="pointer-events-none absolute right-2.5 top-2.5 material-symbols-outlined text-outline text-base">expand_more</span>
                    </div>
                    <span asp-validation-for="Type" class="text-error text-xs mt-1 block"></span>
                </div>

                <div>
                    <label class="block font-label-md text-xs text-on-surface-variant mb-1.5 font-medium uppercase tracking-wider" asp-for="Source">
                        Kaynak <span class="text-error">*</span>
                    </label>
                    <div class="relative">
                        <select asp-for="Source" asp-items="Html.GetEnumSelectList<IsoDof.Web.Models.Entities.Enums.DofSource>()"
                                class="w-full bg-surface-container border border-outline-variant/40 text-on-surface text-xs rounded-xl px-3 py-2.5 appearance-none focus:outline-none focus:border-primary transition-all">
                        </select>
                        <span class="pointer-events-none absolute right-2.5 top-2.5 material-symbols-outlined text-outline text-base">expand_more</span>
                    </div>
                    <span asp-validation-for="Source" class="text-error text-xs mt-1 block"></span>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div>
                    <label class="block font-label-md text-xs text-on-surface-variant mb-1.5 font-medium uppercase tracking-wider" asp-for="DepartmentId">
                        Departman <span class="text-error">*</span>
                    </label>
                    <div class="relative">
                        <select asp-for="DepartmentId" asp-items="ViewBag.Departments"
                                class="w-full bg-surface-container border border-outline-variant/40 text-on-surface text-xs rounded-xl px-3 py-2.5 appearance-none focus:outline-none focus:border-primary transition-all">
                        </select>
                        <span class="pointer-events-none absolute right-2.5 top-2.5 material-symbols-outlined text-outline text-base">expand_more</span>
                    </div>
                    <span asp-validation-for="DepartmentId" class="text-error text-xs mt-1 block"></span>
                </div>

                <div>
                    <label class="block font-label-md text-xs text-on-surface-variant mb-1.5 font-medium uppercase tracking-wider" asp-for="AssignedToUserId">
                        Atanan Sorumlu
                    </label>
                    <div class="relative">
                        <select asp-for="AssignedToUserId" asp-items="ViewBag.Users"
                                class="w-full bg-surface-container border border-outline-variant/40 text-on-surface text-xs rounded-xl px-3 py-2.5 appearance-none focus:outline-none focus:border-primary transition-all">
                            <option value="">-- Atanmadı --</option>
                        </select>
                        <span class="pointer-events-none absolute right-2.5 top-2.5 material-symbols-outlined text-outline text-base">expand_more</span>
                    </div>
                    <span asp-validation-for="AssignedToUserId" class="text-error text-xs mt-1 block"></span>
                </div>

                <div>
                    <label class="block font-label-md text-xs text-on-surface-variant mb-1.5 font-medium uppercase tracking-wider" asp-for="DueDate">
                        Termin Tarihi
                    </label>
                    <input asp-for="DueDate" type="date"
                           class="w-full bg-surface-container border border-outline-variant/40 px-3 py-2 rounded-xl text-on-surface font-code-sm text-xs focus:outline-none focus:border-primary transition-all" />
                    <span asp-validation-for="DueDate" class="text-error text-xs mt-1 block"></span>
                </div>
            </div>

            <div>
                <label class="block font-headline-sm text-xs font-semibold text-on-surface mb-2 uppercase tracking-wider" asp-for="Description">
                    Problem & Uygunsuzluk Tanımı <span class="text-error">*</span>
                </label>
                <textarea asp-for="Description" rows="5" required
                          class="w-full bg-surface-container border border-outline-variant/40 p-3.5 rounded-xl font-body-md text-xs sm:text-sm text-on-surface placeholder:text-outline focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/30 transition-all leading-relaxed"></textarea>
                <span asp-validation-for="Description" class="text-error text-xs block"></span>
            </div>
        </div>

        <div class="flex items-center justify-between">
            <a asp-action="Details" asp-route-id="@Model.Id" class="px-4 py-2 rounded-xl text-xs font-medium text-on-surface-variant hover:text-on-surface transition-colors border border-outline-variant/30">
                Vazgeç
            </a>
            <button type="submit" class="inline-flex items-center gap-2 bg-primary hover:bg-primary-container text-on-primary px-6 py-2.5 rounded-xl font-label-md text-sm font-semibold transition-all shadow-md">
                <span class="material-symbols-outlined text-base">save</span>
                <span>Değişiklikleri Kaydet</span>
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}