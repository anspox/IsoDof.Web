@model IEnumerable<IsoDof.Web.Models.Entities.Dof>

@{
    ViewData["Title"] = "DÖF Kayıtları";
}

<h1>DÖF Kayıtları</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Yeni DÖF</a>
</p>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <select name="departmentId" asp-items="ViewBag.Departments" class="form-control">
            <option value="">Tüm Departmanlar</option>
        </select>
    </div>
    <div class="col-auto">
        <select name="status" asp-items="ViewBag.StatusList" class="form-control">
            <option value="">Tüm Durumlar</option>
        </select>
    </div>
    <div class="col-auto">
        <select name="sortOrder" class="form-control">
            <option value="">En Yeni</option>
            <option value="oldest" selected="@(ViewBag.SortOrder == "oldest")">En Eski</option>
            <option value="duedate_asc" selected="@(ViewBag.SortOrder == "duedate_asc")">Bitiş Tarihi (Yakın → Uzak)</option>
            <option value="duedate_desc" selected="@(ViewBag.SortOrder == "duedate_desc")">Bitiş Tarihi (Uzak → Yakın)</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-secondary">Filtrele</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Temizle</a>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Başlık</th>
            <th>Tür</th>
            <th>Durum</th>
            <th>Departman</th>
            <th>Atanan</th>
            <th>Gecikmiş mi?</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var dof in Model)
        {
            <tr class="@(dof.IsOverdue ? "table-danger" : "")">
                <td>@dof.Title</td>
                <td>@dof.Type</td>
                <td>@dof.Status</td>
                <td>@(dof.Department?.Name ?? "-")</td>
                <td>@(dof.AssignedToUser?.FullName ?? "-")</td>
                <td>@(dof.IsOverdue ? "Evet" : "Hayır")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@dof.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                    <a asp-action="Details" asp-route-id="@dof.Id" class="btn btn-sm btn-outline-secondary">Detay</a>
                    <a asp-action="Delete" asp-route-id="@dof.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>