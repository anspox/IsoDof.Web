@model IsoDof.Web.Models.Entities.Dof

@{
    ViewData["Title"] = $"DÖF-#{Model.Id:D4} Detay";
}

<div class="flex flex-col w-full gap-space-lg">
    <!-- DOSSIER HEADER SUB-BAR -->
    <div class="flex flex-col xl:flex-row xl:items-center xl:justify-between gap-space-md bg-surface-container-low p-space-md rounded-xl shadow-md border border-outline-variant/20">
        <div class="flex flex-col gap-space-2xs min-w-0">
            <div class="flex items-center gap-space-xs text-on-surface-variant font-code-sm text-code-sm uppercase tracking-wider">
                <a asp-action="Index" class="hover:underline text-outline">DÖF Kayıtları</a>
                <span class="material-symbols-outlined text-[0.875rem] text-outline">chevron_right</span>
                <span class="text-primary font-semibold">DÖF-#@Model.Id.ToString("D4")</span>
            </div>
            <div class="flex flex-wrap items-center gap-space-md">
                <h1 class="font-headline-xl text-headline-xl text-on-surface tracking-tight font-bold">
                    @Model.Title
                </h1>
                <span class="font-label-sm text-label-sm px-space-sm py-space-2xs rounded-full border font-bold
                      @(Model.Status == IsoDof.Web.Models.Entities.Enums.DofStatus.Kapatildi ? "bg-tertiary/10 text-tertiary border-tertiary/30" :
                        (Model.Status == IsoDof.Web.Models.Entities.Enums.DofStatus.Reddedildi ? "bg-error/10 text-error border-error/30" :
                         "bg-primary/10 text-primary border-primary/30"))">
                    Durum: @Model.Status
                </span>
                @if (Model.IsOverdue)
                {
                    <span class="inline-flex items-center gap-space-2xs bg-error-container/30 text-error px-space-sm py-space-2xs rounded-full font-label-sm text-label-sm font-bold border border-error/30 animate-pulse">
                        <span class="w-1.5 h-1.5 rounded-full bg-error"></span>
                        GECİKMİŞ (SLA)
                    </span>
                }
            </div>
            <p class="font-body-sm text-body-sm text-on-surface-variant">
                Oluşturulma: <span class="font-code-sm text-on-surface">@Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span> •
                Açan: <span class="text-secondary font-medium">@(Model.CreatedByUser?.FullName ?? "Bilinmiyor")</span> •
                Departman: <span class="text-on-surface font-medium">@(Model.Department?.Name ?? "-")</span>
            </p>
        </div>

        <!-- ACTIONS -->
        <div class="flex flex-wrap items-center gap-space-xs">
            <a asp-action="Index" class="inline-flex items-center gap-space-2xs bg-surface-container hover:bg-surface-container-high text-on-surface px-space-md py-space-xs rounded-lg font-label-sm text-label-sm border border-outline-variant/30 transition-colors">
                <span class="material-symbols-outlined text-[1rem]">arrow_back</span>
                <span>Listeye Dön</span>
            </a>

            @if (!Model.IsArchived)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="inline-flex items-center gap-space-2xs bg-surface-container hover:bg-surface-container-high text-primary px-space-md py-space-xs rounded-lg font-label-sm text-label-sm border border-outline-variant/30 transition-colors">
                    <span class="material-symbols-outlined text-[1rem]">edit</span>
                    <span>Düzenle</span>
                </a>
                <a asp-action="Archive" asp-route-id="@Model.Id" class="inline-flex items-center gap-space-2xs bg-surface-container hover:bg-error-container/20 text-outline hover:text-error px-space-md py-space-xs rounded-lg font-label-sm text-label-sm border border-outline-variant/30 transition-colors">
                    <span class="material-symbols-outlined text-[1rem]">archive</span>
                    <span>Arşivle</span>
                </a>
            }
        </div>
    </div>

    <!-- MAIN DOSSIER SPLIT (8 / 4) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg">
        <!-- LEFT COLUMN (8 COLS): DETAILS, ACTIONS, COMMENTS -->
        <div class="lg:col-span-8 flex flex-col gap-space-md">
            <!-- AÇIKLAMA KARTI -->
            <div class="bg-surface-container-low rounded-xl p-space-md shadow-md border border-outline-variant/20 flex flex-col gap-space-xs">
                <div class="flex items-center gap-space-xs pb-space-xs border-b border-outline-variant/20">
                    <span class="material-symbols-outlined text-primary text-[1.25rem]">description</span>
                    <h2 class="font-title-md text-title-md text-on-surface font-bold">Uygunsuzluk & Problem Tanımı</h2>
                </div>
                <p class="font-body-md text-body-md text-on-surface whitespace-pre-wrap leading-relaxed pt-space-xs">
                    @Model.Description
                </p>
            </div>

            <!-- FAALİYET ADIMLARI (ACTION STEPS) -->
            <div class="bg-surface-container-low rounded-xl p-space-md shadow-md border border-outline-variant/20 flex flex-col gap-space-md">
                <div class="flex items-center justify-between pb-space-xs border-b border-outline-variant/20">
                    <div class="flex items-center gap-space-xs">
                        <span class="material-symbols-outlined text-secondary text-[1.25rem]">task_alt</span>
                        <h2 class="font-title-md text-title-md text-on-surface font-bold">Faaliyet Adımları</h2>
                    </div>
                    <span class="font-code-sm text-code-sm bg-surface-container text-secondary px-space-xs py-space-2xs rounded border border-secondary/20">
                        @Model.Actions.Count(a => a.IsCompleted) / @Model.Actions.Count Tamamlandı
                    </span>
                </div>

                @if (!Model.Actions.Any())
                {
                    <div class="p-4 text-center text-on-surface-variant font-body-sm text-body-sm bg-surface-container rounded-lg border border-outline-variant/20">
                        Henüz faaliyet adımı tanımlanmamış.
                    </div>
                }
                else
                {
                    <div class="flex flex-col gap-space-xs">
                        @foreach (var action in Model.Actions)
                        {
                            <div class="p-space-sm bg-surface-container rounded-lg border border-outline-variant/20 flex items-center justify-between gap-space-sm">
                                <div class="flex items-center gap-space-sm">
                                    <span class="material-symbols-outlined text-[1.25rem] @(action.IsCompleted ? "text-tertiary" : "text-outline")">
                                        @(action.IsCompleted ? "check_circle" : "radio_button_unchecked")
                                    </span>
                                    <div class="flex flex-col">
                                        <span class="font-label-md text-label-md text-on-surface @(action.IsCompleted ? "line-through opacity-70" : "font-medium")">
                                            @action.Description
                                        </span>
                                        <span class="font-body-sm text-body-sm text-on-surface-variant text-[0.75rem]">
                                            Sorumlu: <strong class="text-on-surface font-medium">@(action.ResponsibleUser?.FullName ?? "-")</strong>
                                        </span>
                                    </div>
                                </div>
                                <span class="font-label-sm text-label-sm px-space-xs py-space-2xs rounded border font-semibold
                                      @(action.IsCompleted ? "bg-tertiary/10 text-tertiary border-tertiary/30" : "bg-warning/10 text-secondary border-secondary/30")">
                                    @(action.IsCompleted ? "Tamamlandı" : "Bekliyor")
                                </span>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- DURUM DEĞİŞİKLİĞİ GEÇMİŞİ (AUDIT TRAIL) -->
            <div class="bg-surface-container-low rounded-xl p-space-md shadow-md border border-outline-variant/20 flex flex-col gap-space-md">
                <div class="flex items-center justify-between pb-space-xs border-b border-outline-variant/20">
                    <div class="flex items-center gap-space-xs">
                        <span class="material-symbols-outlined text-primary text-[1.25rem]">history</span>
                        <h2 class="font-title-md text-title-md text-on-surface font-bold">Durum Değişikliği ve Denetim İzi</h2>
                    </div>
                    <span class="font-code-sm text-code-sm text-outline">Değiştirilemez Kayıt</span>
                </div>

                @if (!Model.StatusHistory.Any())
                {
                    <p class="text-on-surface-variant font-body-sm text-body-sm">Henüz durum değişikliği kaydı yok.</p>
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="w-full text-left font-body-sm text-body-sm text-on-surface">
                            <thead>
                                <tr class="bg-surface-container text-on-surface-variant font-label-sm text-label-sm uppercase tracking-wider border-b border-outline-variant/20">
                                    <th class="py-space-xs px-space-sm">Tarih</th>
                                    <th class="py-space-xs px-space-sm">İşlemi Yapan</th>
                                    <th class="py-space-xs px-space-sm">Eski Durum</th>
                                    <th class="py-space-xs px-space-sm">Yeni Durum</th>
                                    <th class="py-space-xs px-space-sm">Not</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-outline-variant/10">
                                @foreach (var h in Model.StatusHistory.OrderBy(x => x.ChangedAt))
                                {
                                    <tr class="hover:bg-surface-container/50">
                                        <td class="py-space-xs px-space-sm font-code-sm text-code-sm text-outline whitespace-nowrap">
                                            @h.ChangedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                        </td>
                                        <td class="py-space-xs px-space-sm font-label-sm text-label-sm text-on-surface whitespace-nowrap">
                                            @(h.ChangedByUser?.FullName ?? "-")
                                        </td>
                                        <td class="py-space-xs px-space-sm font-code-sm text-code-sm text-outline">
                                            @(h.OldStatus?.ToString() ?? "—")
                                        </td>
                                        <td class="py-space-xs px-space-sm font-code-sm text-code-sm text-primary font-bold">
                                            @h.NewStatus
                                        </td>
                                        <td class="py-space-xs px-space-sm text-on-surface-variant text-[0.8125rem]">
                                            @h.Note
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <!-- YORUMLAR (COMMENTS) -->
            <div class="bg-surface-container-low rounded-xl p-space-md shadow-md border border-outline-variant/20 flex flex-col gap-space-md">
                <div class="flex items-center justify-between pb-space-xs border-b border-outline-variant/20">
                    <div class="flex items-center gap-space-xs">
                        <span class="material-symbols-outlined text-primary text-[1.25rem]">forum</span>
                        <h2 class="font-title-md text-title-md text-on-surface font-bold">Yorumlar & Görüşler</h2>
                    </div>
                    <span class="font-code-sm text-code-sm text-primary bg-primary/10 px-space-xs py-space-2xs rounded border border-primary/20">
                        @Model.Comments.Count Yorum
                    </span>
                </div>

                @if (!Model.Comments.Any())
                {
                    <div class="py-6 text-center text-on-surface-variant font-body-sm text-body-sm">
                        Henüz yorum yapılmamış. İlk değerlendirmeyi aşağıdan ekleyebilirsiniz.
                    </div>
                }
                else
                {
                    <div class="flex flex-col gap-space-sm">
                        @foreach (var comment in Model.Comments)
                        {
                            <div class="p-space-sm bg-surface-container rounded-lg border border-outline-variant/20 flex flex-col gap-space-2xs">
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center gap-space-xs">
                                        <div class="w-6 h-6 rounded-full bg-primary/20 text-primary font-code-sm text-code-sm flex items-center justify-center font-bold">
                                            @(comment.AuthorUser?.FullName?.Length > 0 ? comment.AuthorUser.FullName.Substring(0, 1).ToUpper() : "U")
                                        </div>
                                        <strong class="font-label-md text-label-md text-on-surface">@(comment.AuthorUser?.FullName ?? "-")</strong>
                                    </div>
                                    <small class="font-code-sm text-code-sm text-outline">
                                        @comment.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                    </small>
                                </div>
                                <div class="font-body-sm text-body-sm text-on-surface pl-8 whitespace-pre-wrap">
                                    @comment.Text
                                </div>
                            </div>
                        }
                    </div>
                }

                <!-- YORUM EKLE FORMU -->
                <form asp-action="AddComment" asp-controller="Dofs" method="post" class="flex flex-col gap-space-xs pt-space-xs border-t border-outline-variant/20">
                    <input type="hidden" name="dofId" value="@Model.Id" />
                    <textarea name="text" rows="2" placeholder="DÖF hakkında teknik yorum, kök neden analizi veya not ekleyin..." required
                              class="w-full bg-surface-container border border-outline-variant/40 rounded-lg p-space-sm text-on-surface placeholder:text-outline font-body-sm text-body-sm focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary"></textarea>
                    <div class="flex justify-end">
                        <button type="submit" class="inline-flex items-center gap-space-xs bg-primary hover:bg-primary-container text-on-primary font-label-sm text-label-sm px-space-md py-space-xs rounded-lg font-semibold transition-colors shadow-sm">
                            <span class="material-symbols-outlined text-[1rem]">send</span>
                            <span>Yorum Ekle</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- RIGHT COLUMN (4 COLS): META INFO & ATTACHMENTS -->
        <div class="lg:col-span-4 flex flex-col gap-space-md">
            <!-- DÖF META KARTI -->
            <div class="bg-surface-container-low rounded-xl p-space-md shadow-md border border-outline-variant/20 flex flex-col gap-space-sm">
                <div class="flex items-center justify-between pb-space-xs border-b border-outline-variant/20">
                    <span class="font-title-md text-title-md text-on-surface font-bold">DÖF Künyesi</span>
                    <span class="font-code-sm text-code-sm text-secondary font-bold">ISO Uyumlu</span>
                </div>

                <div class="flex flex-col gap-space-xs font-body-sm text-body-sm">
                    <div class="flex items-center justify-between p-space-xs bg-surface-container rounded border border-outline-variant/20">
                        <span class="text-outline">Faaliyet Türü</span>
                        <span class="font-code-sm text-code-sm text-on-surface font-semibold">@Model.Type</span>
                    </div>

                    <div class="flex items-center justify-between p-space-xs bg-surface-container rounded border border-outline-variant/20">
                        <span class="text-outline">Uygunsuzluk Kaynağı</span>
                        <span class="font-label-sm text-label-sm text-on-surface font-semibold">@Model.Source</span>
                    </div>

                    <div class="flex items-center justify-between p-space-xs bg-surface-container rounded border border-outline-variant/20">
                        <span class="text-outline">Departman</span>
                        <span class="font-label-sm text-label-sm text-secondary font-semibold">@(Model.Department?.Name ?? "-")</span>
                    </div>

                    <div class="flex items-center justify-between p-space-xs bg-surface-container rounded border border-outline-variant/20">
                        <span class="text-outline">Açan Personel</span>
                        <span class="font-label-sm text-label-sm text-on-surface">@(Model.CreatedByUser?.FullName ?? "-")</span>
                    </div>

                    <div class="flex items-center justify-between p-space-xs bg-surface-container rounded border border-outline-variant/20">
                        <span class="text-outline">Atanan Sorumlu</span>
                        <span class="font-label-sm text-label-sm text-primary font-semibold">@(Model.AssignedToUser?.FullName ?? "Atanmadı")</span>
                    </div>

                    <div class="flex items-center justify-between p-space-xs bg-surface-container rounded border border-outline-variant/20">
                        <span class="text-outline">Termin Tarihi (SLA)</span>
                        <span class="font-code-sm text-code-sm @(Model.IsOverdue ? "text-error font-bold" : "text-on-surface")">
                            @(Model.DueDate?.ToString("dd.MM.yyyy") ?? "—")
                        </span>
                    </div>

                    @if (Model.ClosedAt.HasValue)
                    {
                        <div class="flex items-center justify-between p-space-xs bg-surface-container rounded border border-outline-variant/20">
                            <span class="text-outline">Kapanış Tarihi</span>
                            <span class="font-code-sm text-code-sm text-tertiary font-bold">
                                @Model.ClosedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            </span>
                        </div>
                    }

                    @if (Model.IsArchived)
                    {
                        <div class="p-space-xs bg-surface-container rounded border border-error/30 flex flex-col gap-1 text-error">
                            <div class="flex items-center justify-between font-label-sm text-label-sm font-bold">
                                <span>ARŞİVLENDİ</span>
                                <span>@Model.ArchivedAt?.ToLocalTime().ToString("dd.MM.yyyy")</span>
                            </div>
                            <span class="text-[0.75rem] text-on-surface-variant">
                                Arşivleyen: @(Model.ArchivedByUser?.FullName ?? "-")
                            </span>
                            @if (!string.IsNullOrWhiteSpace(Model.ArchiveReason))
                            {
                                <span class="text-[0.75rem] text-outline">Neden: @Model.ArchiveReason</span>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- DOSYA EKLERİ KARTI (ATTACHMENTS) -->
            <div class="bg-surface-container-low rounded-xl p-space-md shadow-md border border-outline-variant/20 flex flex-col gap-space-md">
                <div class="flex items-center justify-between pb-space-xs border-b border-outline-variant/20">
                    <div class="flex items-center gap-space-xs">
                        <span class="material-symbols-outlined text-secondary text-[1.25rem]">attach_file</span>
                        <span class="font-title-md text-title-md text-on-surface font-bold">Dosya Ekleri & Kanıtlar</span>
                    </div>
                    <span class="font-code-sm text-code-sm text-secondary bg-secondary/10 px-space-xs py-space-2xs rounded border border-secondary/20">
                        @Model.Attachments.Count Dosya
                    </span>
                </div>

                @if (TempData["UploadError"] != null)
                {
                    <div class="p-space-xs bg-error-container/20 text-error rounded font-body-sm text-body-sm border border-error/30">
                        @TempData["UploadError"]
                    </div>
                }

                @if (!Model.Attachments.Any())
                {
                    <div class="py-4 text-center text-on-surface-variant font-body-sm text-body-sm">
                        Henüz kanıt veya ek dosya yüklenmemiş.
                    </div>
                }
                else
                {
                    <div class="flex flex-col gap-space-xs">
                        @foreach (var attachment in Model.Attachments)
                        {
                            <div class="p-space-xs bg-surface-container rounded-lg border border-outline-variant/20 flex items-center justify-between gap-space-xs">
                                <a href="~/uploads/dof-attachments/@attachment.StoredFileName" target="_blank"
                                   class="font-label-sm text-label-sm text-primary hover:underline truncate max-w-[200px] flex items-center gap-1">
                                    <span class="material-symbols-outlined text-[1rem]">description</span>
                                    <span>@attachment.FileName</span>
                                </a>
                                <span class="font-code-sm text-code-sm text-outline text-[0.6875rem] whitespace-nowrap">
                                    @attachment.UploadedAt.ToLocalTime().ToString("dd.MM.yyyy")
                                </span>
                            </div>
                        }
                    </div>
                }

                <!-- DOSYA YÜKLE FORMU -->
                <form asp-action="UploadAttachment" asp-controller="Dofs" method="post" enctype="multipart/form-data" class="flex flex-col gap-space-xs pt-space-xs border-t border-outline-variant/20">
                    <input type="hidden" name="dofId" value="@Model.Id" />
                    <input type="file" name="file" required
                           class="w-full bg-surface-container text-on-surface font-body-sm text-body-sm p-1.5 rounded-lg border border-outline-variant/30 file:mr-3 file:py-1 file:px-2 file:rounded file:border-0 file:text-xs file:bg-surface-container-high file:text-primary hover:file:bg-primary-container hover:file:text-white" />
                    <button type="submit" class="inline-flex items-center justify-center gap-space-xs bg-surface-container hover:bg-surface-container-high text-primary font-label-sm text-label-sm py-space-xs rounded-lg transition-colors border border-outline-variant/30">
                        <span class="material-symbols-outlined text-[1rem]">cloud_upload</span>
                        <span>Dosyayı Sisteme Ekle</span>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>