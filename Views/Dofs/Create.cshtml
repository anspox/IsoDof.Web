@model IsoDof.Web.Models.Entities.Dof

@{
    ViewData["Title"] = "Yeni DÖF / CAPA Kaydı";
}

<div class="max-w-6xl mx-auto pb-24 text-on-surface">
    <!-- HEADER -->
    <header class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 bg-surface-container-low p-space-md rounded-2xl border border-outline-variant/20 shadow-md">
        <div>
            <div class="flex items-center gap-3 mb-1">
                <div class="flex items-center gap-2">
                    <a asp-action="Index" class="font-code-sm text-xs text-outline hover:text-primary transition-colors flex items-center gap-1">
                        <span class="material-symbols-outlined text-sm">arrow_back</span>
                        <span>DÖF Listesi</span>
                    </a>
                    <span class="text-outline/40">/</span>
                    <h1 class="font-headline-xl text-xl font-bold text-on-surface tracking-tight">Yeni DÖF / CAPA Kaydı</h1>
                </div>
                <span class="px-2.5 py-0.5 rounded-md bg-surface-container border border-outline-variant/30 text-primary font-code-sm text-xs font-semibold">
                    #DÖF-YENİ
                </span>
            </div>
            <p class="font-body-sm text-xs text-on-surface-variant">
                Uygunsuzluk detaylarını girin, sorumlu kişiyi belirleyin ve denetim kanıtlarını ekleyin.
            </p>
        </div>

        <div class="flex items-center gap-2 bg-surface-container border border-outline-variant/20 p-1 rounded-xl self-start sm:self-auto">
            <span class="px-2.5 py-1 text-xs font-code-sm text-outline font-medium">Öncelik Seviyesi:</span>
            <span class="px-2.5 py-1 rounded-lg text-xs font-semibold font-code-sm bg-error-container/20 text-error border border-error/30 shadow-[0_0_12px_rgba(255,180,171,0.15)] flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-error animate-ping"></span>
                <span>Standart / Triage</span>
            </span>
        </div>
    </header>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
    {
        <div class="mb-6 p-4 rounded-xl bg-error-container/20 border border-error/30 text-error text-xs flex flex-col gap-1">
            <div class="font-bold flex items-center gap-1">
                <span class="material-symbols-outlined text-base">error</span>
                <span>Lütfen formdaki eksik veya hatalı alanları düzeltiniz:</span>
            </div>
            <div asp-validation-summary="All" class="pl-5 text-on-surface"></div>
        </div>
    }

    <!-- FORM WRAPPER -->
    <form asp-action="Create" method="post" enctype="multipart/form-data" id="dof-create-form">
        @Html.AntiForgeryToken()

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
            <!-- LEFT COLUMN (8 COLS): CORE DETAILS, TECHNICAL FINDINGS, EVIDENCE -->
            <div class="lg:col-span-8 flex flex-col gap-6">
                <!-- CARD 1: PRIMARY DETAILS -->
                <div class="bg-surface-container-low border border-outline-variant/20 rounded-2xl p-6 shadow-sm flex flex-col gap-5">
                    <div>
                        <label class="block font-label-md text-xs font-semibold text-on-surface mb-2 uppercase tracking-wider" asp-for="Title">
                            Uygunsuzluk Konusu / Başlık <span class="text-error">*</span>
                        </label>
                        <input asp-for="Title" class="w-full bg-surface-container border border-outline-variant/40 px-4 py-2.5 rounded-xl text-on-surface font-body-md text-sm placeholder:text-outline focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/30 transition-all"
                               placeholder="Örn: CNC Torna Milinde Tolerans Aşımı (Batch #88A)" required />
                        <span asp-validation-for="Title" class="text-error text-xs mt-1 block"></span>
                    </div>

                    <!-- ACTION CLASSIFICATION (TYPE) -->
                    <div>
                        <label class="block font-label-md text-xs text-on-surface-variant uppercase tracking-wider mb-2 font-medium">
                            Faaliyet Türü (DÖF Sınıflandırması) <span class="text-error">*</span>
                        </label>
                        <div class="grid grid-cols-2 gap-3">
                            <label id="btn-corrective" class="cursor-pointer flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl border font-medium text-sm transition-all shadow-[0_0_14px_rgba(79,219,200,0.1)] bg-primary/10 border-primary/40 text-primary">
                                <input type="radio" asp-for="Type" value="@IsoDof.Web.Models.Entities.Enums.DofType.Duzeltici" class="hidden" checked />
                                <span class="material-symbols-outlined text-base">build_circle</span>
                                <span>Düzeltici Faaliyet</span>
                            </label>
                            <label id="btn-preventive" class="cursor-pointer flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl border font-medium text-sm transition-all bg-surface-container border-outline-variant/30 text-on-surface-variant hover:text-on-surface hover:border-outline-variant/60">
                                <input type="radio" asp-for="Type" value="@IsoDof.Web.Models.Entities.Enums.DofType.Onleyici" class="hidden" />
                                <span class="material-symbols-outlined text-base">shield</span>
                                <span>Önleyici Faaliyet</span>
                            </label>
                        </div>
                        <span asp-validation-for="Type" class="text-error text-xs mt-1 block"></span>
                    </div>

                    <!-- 3 SELECTS: SOURCE, DEPARTMENT, ASSIGNEE -->
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        <div>
                            <label class="block font-label-md text-xs text-on-surface-variant mb-1.5 font-medium uppercase tracking-wider" asp-for="Source">
                                Kaynak <span class="text-error">*</span>
                            </label>
                            <div class="relative">
                                <select asp-for="Source" asp-items="Html.GetEnumSelectList<IsoDof.Web.Models.Entities.Enums.DofSource>()"
                                        class="w-full bg-surface-container border border-outline-variant/40 text-on-surface text-xs rounded-xl px-3 py-2.5 appearance-none focus:outline-none focus:border-secondary transition-all">
                                </select>
                                <span class="pointer-events-none absolute right-2.5 top-2.5 material-symbols-outlined text-outline text-base">expand_more</span>
                            </div>
                            <span asp-validation-for="Source" class="text-error text-xs mt-1 block"></span>
                        </div>

                        <div>
                            <label class="block font-label-md text-xs text-on-surface-variant mb-1.5 font-medium uppercase tracking-wider" asp-for="DepartmentId">
                                Departman <span class="text-error">*</span>
                            </label>
                            <div class="relative">
                                <select asp-for="DepartmentId" asp-items="ViewBag.Departments" id="DepartmentId"
                                        class="w-full bg-surface-container border border-outline-variant/40 text-on-surface text-xs rounded-xl px-3 py-2.5 appearance-none focus:outline-none focus:border-secondary transition-all" required>
                                    <option value="">-- Departman Seçin --</option>
                                </select>
                                <span class="pointer-events-none absolute right-2.5 top-2.5 material-symbols-outlined text-outline text-base">expand_more</span>
                            </div>
                            <span asp-validation-for="DepartmentId" class="text-error text-xs mt-1 block"></span>
                        </div>

                        <div>
                            <label class="block font-label-md text-xs text-on-surface-variant mb-1.5 font-medium uppercase tracking-wider" asp-for="AssignedToUserId">
                                Atanan Sorumlu
                            </label>
                            <div class="relative">
                                <select asp-for="AssignedToUserId" asp-items="ViewBag.Users" id="AssignedToUserId"
                                        class="w-full bg-surface-container border border-outline-variant/40 text-on-surface text-xs rounded-xl px-3 py-2.5 appearance-none focus:outline-none focus:border-secondary transition-all">
                                    <option value="">-- Otomatik Sorumlu --</option>
                                </select>
                                <span class="pointer-events-none absolute right-2.5 top-2.5 material-symbols-outlined text-outline text-base">expand_more</span>
                            </div>
                            <span asp-validation-for="AssignedToUserId" class="text-error text-xs mt-1 block"></span>
                        </div>
                    </div>

                    <!-- SLA DUE DATE & CURRENT USER INFO -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2 border-t border-outline-variant/20">
                        <div>
                            <label class="block font-label-md text-xs text-on-surface-variant mb-1.5 font-medium uppercase tracking-wider" asp-for="DueDate">
                                SLA Hedef Çözüm Tarihi (Termin) <span class="text-error">*</span>
                            </label>
                            <input asp-for="DueDate" type="date" min="@DateTime.UtcNow.ToString("yyyy-MM-dd")" required
                                   class="w-full bg-surface-container border border-outline-variant/40 px-3 py-2 rounded-xl text-on-surface font-code-sm text-xs focus:outline-none focus:border-primary transition-all" />
                            <span asp-validation-for="DueDate" class="text-error text-xs mt-1 block"></span>
                        </div>

                        <div>
                            <label class="block font-label-md text-xs text-on-surface-variant mb-1.5 font-medium uppercase tracking-wider">
                                Kaydı Başlatan Personel
                            </label>
                            <div class="flex items-center gap-2 bg-surface-container border border-outline-variant/40 rounded-xl px-3 py-2">
                                <div class="w-6 h-6 rounded-full bg-primary/20 text-primary font-code-sm text-xs flex items-center justify-center font-bold">
                                    @(ViewBag.CurrentUserName != null && ((string)ViewBag.CurrentUserName).Length > 0 ? ((string)ViewBag.CurrentUserName).Substring(0, 1).ToUpper() : "U")
                                </div>
                                <span class="text-xs text-on-surface font-medium truncate">@ViewBag.CurrentUserName</span>
                                <span class="text-[0.625rem] text-secondary font-mono bg-surface-container-high px-1.5 py-0.5 rounded ml-auto">Doğrulandı</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- CARD 2: TECHNICAL DESCRIPTION -->
                <div class="bg-surface-container-low border border-outline-variant/20 rounded-2xl p-6 shadow-sm flex flex-col gap-3">
                    <div class="flex items-center justify-between">
                        <label class="font-headline-sm text-xs font-semibold text-on-surface uppercase tracking-wider" asp-for="Description">
                            Teknik Açıklama ve Uygunsuzluk Bulguları <span class="text-error">*</span>
                        </label>
                        <div class="flex items-center gap-1 text-outline text-xs">
                            <span class="material-symbols-outlined text-sm">fact_check</span>
                            <span>Detaylı 8D Kök Neden Tanımı</span>
                        </div>
                    </div>
                    <textarea asp-for="Description" rows="5" required
                              class="w-full bg-surface-container border border-outline-variant/40 p-3.5 rounded-xl font-body-md text-xs sm:text-sm text-on-surface placeholder:text-outline focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/30 transition-all leading-relaxed"
                              placeholder="Tespit edilen sapmayı, etkilenen parti/lot numaralarını, ölçülen değerleri ve alınan acil çevreleme önlemlerini detaylı olarak belirtiniz..."></textarea>
                    <span asp-validation-for="Description" class="text-error text-xs block"></span>
                </div>

                <!-- CARD 3: EVIDENCE & ATTACHMENTS DROPZONE -->
                <div class="bg-surface-container-low border border-outline-variant/20 rounded-2xl p-6 shadow-sm flex flex-col gap-3">
                    <div class="flex items-center justify-between">
                        <h3 class="font-headline-sm text-xs font-semibold text-on-surface uppercase tracking-wider">
                            Kanıt, Kalibrasyon & Denetim Dosyaları
                        </h3>
                        <span class="text-outline text-xs font-code-sm">PDF, Görsel, Excel</span>
                    </div>

                    <div class="relative border border-dashed border-outline-variant/60 hover:border-primary/60 bg-surface-container/40 hover:bg-surface-container/70 rounded-xl p-6 flex flex-col items-center justify-center text-center cursor-pointer transition-all group">
                        <input type="file" name="file" id="dof-file-input"
                               class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" />
                        <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary mb-2 group-hover:scale-105 transition-transform">
                            <span class="material-symbols-outlined text-xl">cloud_upload</span>
                        </div>
                        <p class="font-body-md text-xs text-on-surface font-medium" id="file-label-text">
                            Tıklayın veya denetim dosyasını buraya sürükleyin
                        </p>
                        <span class="font-body-sm text-[11px] text-outline mt-0.5">
                            PDF, JPG, PNG, DOCX, XLSX (Maks. 10MB)
                        </span>
                    </div>

                    <div id="selected-file-preview" class="hidden flex items-center justify-between bg-surface-container border border-secondary/30 px-3 py-2 rounded-xl">
                        <div class="flex items-center gap-2.5 min-w-0">
                            <span class="material-symbols-outlined text-base text-secondary">description</span>
                            <span class="text-xs text-on-surface truncate font-medium" id="selected-file-name">dosya.pdf</span>
                        </div>
                        <button type="button" id="clear-file-btn" class="text-outline hover:text-error transition-colors p-1" title="Kaldır">
                            <span class="material-symbols-outlined text-sm">close</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- RIGHT COLUMN (4 COLS): VERIFICATION GATE & AUDIT CHECKLIST -->
            <aside class="lg:col-span-4 flex flex-col gap-5">
                <div class="bg-surface-container-low border border-outline-variant/20 rounded-2xl p-5 shadow-sm sticky top-24 flex flex-col gap-4">
                    <div class="flex items-center justify-between pb-2 border-b border-outline-variant/20">
                        <span class="font-headline-sm text-xs font-semibold text-on-surface uppercase tracking-wider">Doğrulama Kapısı</span>
                        <span class="font-code-sm text-xs text-tertiary font-bold">ISO 9001:2015</span>
                    </div>

                    <div class="w-full bg-surface-container h-1.5 rounded-full overflow-hidden">
                        <div class="bg-gradient-to-r from-secondary to-primary h-full rounded-full transition-all" style="width: 80%;"></div>
                    </div>

                    <div class="space-y-3 font-body-sm text-xs">
                        <label class="flex items-start gap-2.5 cursor-pointer">
                            <input type="checkbox" checked class="mt-0.5 accent-primary h-3.5 w-3.5 rounded bg-surface-container border-outline-variant/40" />
                            <span class="text-on-surface leading-tight">Etkilenen partiler / alan fiziki karantinaya alındı</span>
                        </label>
                        <label class="flex items-start gap-2.5 cursor-pointer">
                            <input type="checkbox" checked class="mt-0.5 accent-primary h-3.5 w-3.5 rounded bg-surface-container border-outline-variant/40" />
                            <span class="text-on-surface leading-tight">İlk risk ve aciliyet değerlendirmesi yapıldı</span>
                        </label>
                        <label class="flex items-start gap-2.5 cursor-pointer">
                            <input type="checkbox" checked class="mt-0.5 accent-primary h-3.5 w-3.5 rounded bg-surface-container border-outline-variant/40" />
                            <span class="text-on-surface leading-tight">İlgili departman kalite kontrol sorumlusu bilgilendirildi</span>
                        </label>
                        <label class="flex items-start gap-2.5 cursor-pointer">
                            <input type="checkbox" class="mt-0.5 accent-primary h-3.5 w-3.5 rounded bg-surface-container border-outline-variant/40" />
                            <span class="text-on-surface-variant leading-tight">21 CFR Part 11 uyumlu elektronik doğrulama hazır</span>
                        </label>
                    </div>

                    <div class="p-3 rounded-xl bg-surface-container border border-outline-variant/20 flex flex-col gap-1 text-[0.6875rem] text-on-surface-variant mt-2">
                        <div class="flex items-center gap-1.5 text-primary font-semibold">
                            <span class="material-symbols-outlined text-sm">info</span>
                            <span>Otomatik Atama Kuralı</span>
                        </div>
                        <p class="leading-relaxed">
                            Atanan kişi boş bırakılırsa, seçilen departmanın yetkili Kalite Kontrol sorumlusuna sistem tarafından otomatik devredilir.
                        </p>
                    </div>

                    <div class="pt-3 border-t border-outline-variant/20 flex items-center justify-between text-xs">
                        <span class="text-outline font-label-md">Denetim Bütünlüğü</span>
                        <span class="text-secondary font-code-sm flex items-center gap-1 font-semibold">
                            <span class="material-symbols-outlined text-sm">verified</span>
                            <span>Tam Uyumlu</span>
                        </span>
                    </div>
                </div>
            </aside>
        </div>

        <!-- STICKY BOTTOM ACTION FOOTER -->
        <footer class="fixed bottom-0 left-64 right-0 z-40 bg-[#031427]/90 backdrop-blur-xl border-t border-outline-variant/30 py-3.5 px-8">
            <div class="max-w-6xl mx-auto flex items-center justify-between gap-4">
                <div class="flex items-center gap-2 text-xs text-on-surface-variant">
                    <span class="w-2 h-2 rounded-full bg-tertiary"></span>
                    <span class="font-body-sm">ISO Standartları Doğrulandı</span>
                </div>
                <div class="flex items-center gap-3">
                    <a asp-action="Index" class="px-4 py-2 rounded-xl text-xs font-medium text-on-surface-variant hover:text-on-surface transition-colors border border-transparent hover:border-outline-variant/30">
                        Vazgeç
                    </a>
                    <button type="submit" id="submit-btn"
                            class="px-5 py-2 rounded-xl bg-gradient-to-r from-primary-container to-secondary text-surface font-label-md text-xs font-bold shadow-[0_0_20px_rgba(14,165,233,0.3)] hover:shadow-[0_0_24px_rgba(14,165,233,0.5)] active:scale-95 transition-all flex items-center gap-1.5 cursor-pointer">
                        <span class="material-symbols-outlined text-base">send</span>
                        <span>DÖF Kaydını Başlat</span>
                    </button>
                </div>
            </div>
        </footer>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            // Type toggle buttons
            const btnCorrective = document.getElementById('btn-corrective');
            const btnPreventive = document.getElementById('btn-preventive');
            const radioCorrective = btnCorrective?.querySelector('input');
            const radioPreventive = btnPreventive?.querySelector('input');

            btnCorrective?.addEventListener('click', () => {
                btnCorrective.className = "cursor-pointer flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl border font-medium text-sm transition-all shadow-[0_0_14px_rgba(79,219,200,0.1)] bg-primary/10 border-primary/40 text-primary";
                btnPreventive.className = "cursor-pointer flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl border font-medium text-sm transition-all bg-surface-container border-outline-variant/30 text-on-surface-variant hover:text-on-surface hover:border-outline-variant/60";
            });

            btnPreventive?.addEventListener('click', () => {
                btnPreventive.className = "cursor-pointer flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl border font-medium text-sm transition-all shadow-[0_0_14px_rgba(79,219,200,0.1)] bg-secondary/10 border-secondary/40 text-secondary";
                btnCorrective.className = "cursor-pointer flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl border font-medium text-sm transition-all bg-surface-container border-outline-variant/30 text-on-surface-variant hover:text-on-surface hover:border-outline-variant/60";
            });

            // Department responsible auto-fetch
            const deptSelect = document.querySelector('#DepartmentId');
            const assignSelect = document.querySelector('#AssignedToUserId');
            if (deptSelect && assignSelect) {
                deptSelect.addEventListener('change', function () {
                    const id = deptSelect.value;
                    if (!id) return;
                    fetch('@Url.Action("DepartmentResponsible", "Dofs")?id=' + encodeURIComponent(id))
                        .then(r => r.json())
                        .then(data => {
                            if (data && data.userId) {
                                assignSelect.value = String(data.userId);
                            }
                        })
                        .catch(() => {});
                });
            }

            // File input preview
            const fileInput = document.getElementById('dof-file-input');
            const preview = document.getElementById('selected-file-preview');
            const fileName = document.getElementById('selected-file-name');
            const clearBtn = document.getElementById('clear-file-btn');
            const labelText = document.getElementById('file-label-text');

            fileInput?.addEventListener('change', function () {
                if (fileInput.files && fileInput.files[0]) {
                    const f = fileInput.files[0];
                    fileName.textContent = f.name + " (" + (f.size / (1024 * 1024)).toFixed(2) + " MB)";
                    preview.classList.remove('hidden');
                    labelText.textContent = "Seçilen dosya değiştirilebilir";
                }
            });

            clearBtn?.addEventListener('click', function () {
                fileInput.value = '';
                preview.classList.add('hidden');
                labelText.textContent = "Tıklayın veya denetim dosyasını buraya sürükleyin";
            });
        })();
    </script>
}
