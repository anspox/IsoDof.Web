@model IsoDof.Web.Models.Entities.Dof

@{
    ViewData["Title"] = "Yeni DÖF";
}

<h1>Yeni DÖF</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="Title" class="control-label">Başlık</label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Description" class="control-label">Açıklama</label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Type" class="control-label">Tür</label>
        <select asp-for="Type" asp-items="Html.GetEnumSelectList<IsoDof.Web.Models.Entities.Enums.DofType>()" class="form-control"></select>
        <span asp-validation-for="Type" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Source" class="control-label">Kaynak</label>
        <select asp-for="Source" asp-items="Html.GetEnumSelectList<IsoDof.Web.Models.Entities.Enums.DofSource>()" class="form-control"></select>
        <span asp-validation-for="Source" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="DepartmentId" class="control-label">Departman</label>
        <select asp-for="DepartmentId" asp-items="ViewBag.Departments" class="form-control">
            <option value="">-- Seçiniz --</option>
        </select>
        <span asp-validation-for="DepartmentId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label class="control-label">Açan Kişi</label>
        <input class="form-control" value="@ViewBag.CurrentUserName" disabled />
        <small class="text-muted">DÖF, giriş yapan kullanıcı adına oluşturulur.</small>
    </div>

    <div class="form-group">
        <label asp-for="AssignedToUserId" class="control-label">Atanan Kişi</label>
        <select asp-for="AssignedToUserId" asp-items="ViewBag.Users" class="form-control">
            <option value="">-- Departman sorumlusuna otomatik atanır --</option>
        </select>
        <small class="text-muted">Boş bırakılırsa seçilen departmanın kalite kontrol sorumlusuna atanır.</small>
        <span asp-validation-for="AssignedToUserId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="DueDate" class="control-label">Son Tarih</label>
        <input asp-for="DueDate" class="form-control" type="date" min="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
        <span asp-validation-for="DueDate" class="text-danger"></span>
    </div>

    <div class="form-group mt-3">
        <button type="submit" class="btn btn-primary">Kaydet</button>
        <a asp-action="Index" class="btn btn-secondary">Vazgeç</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var deptSelect = document.querySelector('#DepartmentId');
            var assignSelect = document.querySelector('#AssignedToUserId');
            if (!deptSelect || !assignSelect) return;

            deptSelect.addEventListener('change', function () {
                var id = deptSelect.value;
                if (!id) return;
                fetch('@Url.Action("DepartmentResponsible", "Dofs")?id=' + encodeURIComponent(id))
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        if (data && data.userId) {
                            assignSelect.value = String(data.userId);
                        }
                    })
                    .catch(function () { });
            });
        })();
    </script>
}
