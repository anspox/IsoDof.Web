@model IsoDof.Web.Models.Entities.Dof

@{
    ViewData["Title"] = "DÖF Sil";
}

<h1>DÖF Sil</h1>

<h3>Bu DÖF kaydını silmek istediğine emin misin?</h3>

<div>
    <dl class="row">
        <dt class="col-sm-2">Başlık</dt>
        <dd class="col-sm-10">@Model.Title</dd>

        <dt class="col-sm-2">Departman</dt>
        <dd class="col-sm-10">@(Model.Department?.Name ?? "-")</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Evet, Sil</button>
        <a asp-action="Index" class="btn btn-secondary">Vazgeç</a>
    </form>
</div>