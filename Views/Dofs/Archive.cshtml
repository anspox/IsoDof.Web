@model IsoDof.Web.Models.Entities.Dof

@{
    ViewData["Title"] = "DÖF Arşivle";
}

<div class="max-w-xl mx-auto w-full space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <div class="text-xs text-outline flex items-center gap-2 mb-1">
                <a asp-controller="Dofs" asp-action="Index" class="hover:text-white transition-colors">DÖF Kayıtları</a>
                <span class="text-white/20">/</span>
                <span class="text-on-surface font-medium">CAPA-@Model.Id.ToString("D3") Arşivleme</span>
            </div>
            <h1 class="text-2xl font-semibold text-white tracking-tight">DÖF Kaydını Arşivle</h1>
            <p class="text-xs text-outline mt-0.5">Kayıt kalıcı olarak silinmez, ISO denetim izi korunarak arşive taşınır.</p>
        </div>
        <a asp-action="Details" asp-route-id="@Model.Id" class="text-xs text-outline hover:text-white transition-colors flex items-center gap-1">
            <span class="material-symbols-outlined text-[16px]">arrow_back</span>
            <span>Detaya Dön</span>
        </a>
    </div>

    <!-- Container Card -->
    <div class="bg-surface-container-low border border-white/[0.05] rounded-2xl p-6 sm:p-8 space-y-6">
        <!-- Notice Box -->
        <div class="flex items-start gap-3 p-4 rounded-xl bg-secondary-container/20 border border-secondary/30 text-secondary">
            <span class="material-symbols-outlined text-[22px] mt-0.5">inventory_2</span>
            <div class="text-xs leading-relaxed">
                <strong class="font-semibold text-white">Denetim Uyarısı:</strong> Kayıt silinmez, yalnızca arşive taşınır. İlgili tüm kök neden analizleri, aksiyon adımları ve yorum geçmişi ISO 9001 denetim izinde saklanmaya devam eder.
            </div>
        </div>

        <!-- Target CAPA Details -->
        <div class="space-y-3 py-2 border-y border-white/[0.04]">
            <div class="flex items-center justify-between py-1">
                <span class="text-xs text-outline font-medium">CAPA Referansı</span>
                <span class="font-mono text-xs text-primary font-semibold">CAPA-@Model.Id.ToString("D3")</span>
            </div>
            <div class="flex items-center justify-between py-1">
                <span class="text-xs text-outline font-medium">Başlık</span>
                <span class="text-sm font-medium text-white max-w-sm truncate text-right">@Model.Title</span>
            </div>
            <div class="flex items-center justify-between py-1">
                <span class="text-xs text-outline font-medium">İlgili Departman</span>
                <span class="text-xs text-on-surface">@(Model.Department?.Name ?? "-")</span>
            </div>
            <div class="flex items-center justify-between py-1">
                <span class="text-xs text-outline font-medium">Mevcut Durum</span>
                <span class="px-2 py-0.5 rounded text-[11px] font-medium bg-white/[0.05] text-on-surface-variant border border-white/[0.08]">
                    @Model.Status
                </span>
            </div>
        </div>

        <form asp-action="Archive" method="post" class="space-y-4">
            <input type="hidden" asp-for="Id" />
            <div class="space-y-1.5">
                <label for="archiveReason" class="text-xs font-medium text-outline uppercase tracking-wider block">Arşivleme Nedeni (Gerekçe)</label>
                <textarea id="archiveReason" name="archiveReason" rows="3"
                          placeholder="Örn: Mükerrer kayıt açılması veya hedefin başka bir CAPA ile konsolide edilmesi..."
                          class="w-full p-3 bg-surface-container border border-white/[0.08] text-white placeholder:text-outline/50 rounded-lg text-xs focus:outline-none focus:border-primary/50 transition-colors"></textarea>
            </div>

            <div class="flex items-center justify-end gap-3 pt-2">
                <a asp-action="Details" asp-route-id="@Model.Id" 
                   class="h-9 px-4 rounded-lg text-xs font-medium text-outline hover:text-white transition-colors flex items-center justify-center">
                    Vazgeç
                </a>
                <button type="submit" 
                        class="h-9 px-5 rounded-lg bg-error text-white font-medium text-xs hover:bg-error/80 transition-colors shadow-sm flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-[16px]">archive</span>
                    <span>Evet, Arşive Taşı</span>
                </button>
            </div>
        </form>
    </div>
</div>
