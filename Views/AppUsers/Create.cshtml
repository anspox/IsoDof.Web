@model IsoDof.Web.Models.Entities.AppUser

@{
    ViewData["Title"] = "Kullanıcı Ekle";
}

<h1>Kullanıcı Ekle</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="FullName" class="control-label">Ad Soyad</label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Email" class="control-label">E-posta</label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="DepartmentId" class="control-label">Departman</label>
        <select asp-for="DepartmentId" asp-items="ViewBag.Departments" class="form-control">
            <option value="">-- Seçiniz --</option>
        </select>
        <!-- Hata mesajını gösteren kısım -->
        <span asp-validation-for="DepartmentId" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
    <label asp-for="Role" class="control-label"></label>
    <select asp-for="Role" asp-items="Html.GetEnumSelectList<IsoDof.Web.Models.Entities.Enums.UserRole>()" class="form-control"></select>
    </div>  

    <div class="form-group mb-3">
        <label>Şifre</label>
        <input type="password" name="password" class="form-control" />
    </div>  

    <div class="form-group mt-3">
        <button type="submit" class="btn btn-primary">Kaydet</button>
        <a asp-action="Index" class="btn btn-secondary">Vazgeç</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
