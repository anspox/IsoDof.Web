@model IsoDof.Web.Models.Entities.AppUser

@{
    ViewData["Title"] = "Kullanıcı Sil";
}

<h1>Kullanıcı Sil</h1>

<h3>Bu kullanıcıyı silmek istediğine emin misin?</h3>

<div>
    <dl class="row">
        <dt class="col-sm-2">Ad Soyad</dt>
        <dd class="col-sm-10">@Model.FullName</dd>

        <dt class="col-sm-2">E-posta</dt>
        <dd class="col-sm-10">@Model.Email</dd>

        <dt class="col-sm-2">Departman</dt>
        <dd class="col-sm-10">@(Model.Department?.Name ?? "-")</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Evet, Sil</button>
        <a asp-action="Index" class="btn btn-secondary">Vazgeç</a>
    </form>
</div>