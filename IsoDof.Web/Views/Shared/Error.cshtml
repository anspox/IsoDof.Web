@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<h1 class="text-danger">Hata.</h1>
<h2 class="text-danger">İsteğiniz işlenirken bir hata oluştu.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>İstek No:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>Geliştirme Modu</h3>
<p>
    <strong>Development</strong> ortamına geçildiğinde, oluşan hatayla ilgili daha ayrıntılı bilgi gösterilir.
</p>
<p>
    <strong>Development ortamı yayına alınmış uygulamalarda etkinleştirilmemelidir.</strong>
    İstisnalardan gelen hassas bilgilerin son kullanıcılara gösterilmesine yol açabilir.
    Yerel hata ayıklama için <strong>ASPNETCORE_ENVIRONMENT</strong> ortam değişkenini <strong>Development</strong>
    olarak ayarlayıp uygulamayı yeniden başlatarak <strong>Development</strong> ortamını etkinleştirebilirsiniz.
</p>
