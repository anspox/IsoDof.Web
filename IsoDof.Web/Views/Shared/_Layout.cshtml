@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnv
<!DOCTYPE html>
<html class="dark" lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NISO QMS</title>
    <meta name="description" content="NISO QMS: ISO 9001 uyumlu Düzeltici ve Önleyici Faaliyet (DÖF) takip sistemi." />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#031427" />
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="~/fonts/material-symbols-outlined.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    
    
    <!-- Tailwind CSS: tailwind.config.js + Styles/app.css dosyalarından "npm run build:css" ile derlenir -->
    <link rel="stylesheet" href="~/css/app.min.css" asp-append-version="true" />
</head>
<body class="bg-surface font-sans text-on-surface antialiased">
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <!-- MINIMAL & UNCLUTTERED SIDEBAR -->
        <!-- Mobilde menü açıkken arka planı karartan katman -->
        <div id="sidebarOverlay" class="hidden fixed inset-0 bg-black/60 z-40 lg:hidden" onclick="toggleSidebar(false)"></div>

        <aside id="sidebar" class="fixed left-0 top-0 h-screen w-60 bg-surface-container-low z-50 flex flex-col justify-between py-6 px-4 border-r border-white/[0.06] overflow-y-auto -translate-x-full lg:translate-x-0 transition-transform duration-200">
            <div class="flex flex-col gap-6">
                <!-- Brand Logo -->
                <a asp-controller="Home" asp-action="Index" class="flex items-center gap-3 px-2 text-decoration-none group">
                    <div class="w-9 h-9 rounded-lg bg-primary/10 border border-primary/20 flex items-center justify-center text-primary group-hover:scale-105 transition-transform">
                        <span class="material-symbols-outlined text-[1.35rem]">verified_user</span>
                    </div>
                    <div class="flex flex-col">
                        <span class="font-title-md text-[1rem] tracking-tight font-bold text-white leading-none">NISO <span class="text-primary font-light">QMS</span></span>
                        <span class="text-[0.625rem] text-on-surface-variant uppercase tracking-widest mt-1">Kurumsal ISO</span>
                    </div>
                </a>

                <!-- Clean Navigation -->
                <nav class="flex flex-col gap-1.5">
                    <a asp-controller="Home" asp-action="Index"
                       class="flex items-center gap-3 px-3 py-2.5 rounded-lg transition-colors @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "bg-primary/10 text-primary border border-primary/20 font-semibold" : "text-on-surface-variant hover:text-white hover:bg-white/[0.04]")">
                        <span class="material-symbols-outlined text-[1.25rem]">grid_view</span>
                        <span class="font-label-md text-sm font-medium">Panel</span>
                    </a>

                    <a asp-controller="Dofs" asp-action="Index"
                       class="flex items-center justify-between px-3 py-2.5 rounded-lg transition-colors @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dofs" ? "bg-primary/10 text-primary border border-primary/20 font-semibold" : "text-on-surface-variant hover:text-white hover:bg-white/[0.04]")">
                        <div class="flex items-center gap-3">
                            <span class="material-symbols-outlined text-[1.25rem]">security</span>
                            <span class="font-label-md text-sm font-medium">
                                @(User.IsInRole("KaliteKontrol") ? "Departman Kalitesi" : "DÖF Kayıtları")
                            </span>
                        </div>
                    </a>

                    <a asp-controller="DofActions" asp-action="Index"
                       class="flex items-center gap-3 px-3 py-2.5 rounded-lg transition-colors @(ViewContext.RouteData.Values["Controller"]?.ToString() == "DofActions" ? "bg-primary/10 text-primary border border-primary/20 font-semibold" : "text-on-surface-variant hover:text-white hover:bg-white/[0.04]")">
                        <span class="material-symbols-outlined text-[1.25rem] opacity-70">task_alt</span>
                        <span class="font-label-md text-sm font-medium">Faaliyetler</span>
                    </a>

                    @if (User.IsInRole("Admin") || User.IsInRole("KaliteKontrol"))
                    {
                        <a asp-controller="DofTemplates" asp-action="Index"
                           class="flex items-center gap-3 px-3 py-2.5 rounded-lg transition-colors @(ViewContext.RouteData.Values["Controller"]?.ToString() == "DofTemplates" ? "bg-primary/10 text-primary border border-primary/20 font-semibold" : "text-on-surface-variant hover:text-white hover:bg-white/[0.04]")">
                            <span class="material-symbols-outlined text-[1.25rem] opacity-70">description</span>
                            <span class="font-label-md text-sm font-medium">DÖF Şablonları</span>
                        </a>
                    }

                    @if (User.IsInRole("Admin"))
                    {
                        <div class="pt-3 pb-1 px-3">
                            <span class="text-[0.625rem] font-mono uppercase tracking-widest text-outline">Yönetim Masası</span>
                        </div>

                        <a asp-controller="Departments" asp-action="Index"
                           class="flex items-center gap-3 px-3 py-2 rounded-lg transition-colors text-sm @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Departments" ? "bg-primary/10 text-primary border border-primary/20 font-semibold" : "text-on-surface-variant hover:text-white hover:bg-white/[0.04]")">
                            <span class="material-symbols-outlined text-[1.125rem] opacity-70">corporate_fare</span>
                            <span>Departmanlar</span>
                        </a>

                        <a asp-controller="AppUsers" asp-action="Index"
                           class="flex items-center gap-3 px-3 py-2 rounded-lg transition-colors text-sm @(ViewContext.RouteData.Values["Controller"]?.ToString() == "AppUsers" ? "bg-primary/10 text-primary border border-primary/20 font-semibold" : "text-on-surface-variant hover:text-white hover:bg-white/[0.04]")">
                            <span class="material-symbols-outlined text-[1.125rem] opacity-70">group</span>
                            <span>Kullanıcılar</span>
                        </a>
                    }
                </nav>
            </div>

            <!-- Bottom Utility -->
            <div class="pt-4 border-t border-white/[0.06] flex flex-col gap-1">
                <a asp-controller="Account" asp-action="ChangePassword"
                   class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-on-surface-variant hover:text-white hover:bg-white/[0.04] transition-colors">
                    <span class="material-symbols-outlined text-[1.125rem] opacity-70">key</span>
                    <span>Şifre Değiştir</span>
                </a>
                <a asp-controller="Home" asp-action="Privacy"
                   class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-on-surface-variant hover:text-white hover:bg-white/[0.04] transition-colors">
                    <span class="material-symbols-outlined text-[1.125rem] opacity-70">shield</span>
                    <span>Gizlilik ve KVKK</span>
                </a>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit"
                            class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-on-surface-variant hover:text-error hover:bg-error/[0.06] transition-colors">
                        <span class="material-symbols-outlined text-[1.25rem]">logout</span>
                        <span class="font-label-md text-sm font-medium">Çıkış Yap</span>
                    </button>
                </form>
            </div>
        </aside>

        <!-- MAIN CONTENT WRAPPER -->
        <div class="lg:pl-60 flex-1 flex flex-col min-h-screen min-w-0 bg-surface">
            <!-- CLEAN TOP HEADER -->
            <header class="h-16 sticky top-0 bg-surface/80 backdrop-blur-md border-b border-white/[0.06] z-30 px-4 lg:px-8 flex items-center justify-between gap-3">
                <!-- Page context -->
                <div class="flex items-center gap-2 min-w-0">
                    <button type="button" onclick="toggleSidebar()" aria-label="Menüyü aç/kapat" aria-controls="sidebar"
                            class="lg:hidden -ml-1 p-1.5 rounded-lg text-on-surface-variant hover:text-white hover:bg-white/[0.06] transition-colors">
                        <span class="material-symbols-outlined text-[1.5rem] block">menu</span>
                    </button>
                    <div class="font-label-md text-label-md font-semibold text-on-surface-variant truncate">
                        @ViewData["Title"]
                    </div>
                </div>

                <!-- Header Actions & Profile -->
                <div class="flex items-center gap-3 lg:gap-5 shrink-0">
                    @if (!User.IsInRole("Admin") && !User.IsInRole("KaliteKontrol"))
                    {
                        <a asp-controller="Dofs" asp-action="Create" aria-label="Yeni DÖF"
                           class="flex items-center gap-1.5 bg-primary hover:bg-primary-container text-on-primary px-3 py-1.5 rounded-lg text-xs font-semibold shadow-sm transition-all">
                            <span class="material-symbols-outlined text-[1rem]">add</span>
                            <span class="hidden sm:inline">Yeni DÖF</span>
                        </a>
                    }

                    <!-- Notification Bell -->
                    @await Component.InvokeAsync("NotificationBell")

                    <div class="hidden sm:block h-5 w-px bg-white/[0.08]"></div>

                    <!-- User Profile Pill -->
                    <div class="flex items-center gap-3 py-1 px-2 rounded-full hover:bg-white/[0.04] transition-colors">
                        <div class="w-8 h-8 rounded-full bg-primary/20 text-primary flex items-center justify-center font-bold text-xs ring-1 ring-white/20">
                            @(User.Identity?.Name?.Length > 0 ? User.Identity.Name.Substring(0, 1).ToUpper() : "U")
                        </div>
                        <div class="hidden md:flex flex-col text-left pr-1">
                            <span class="text-xs font-semibold text-white leading-tight">@User.Identity?.Name</span>
                            <span class="text-[0.6875rem] text-on-surface-variant leading-none mt-0.5">
                                @(User.IsInRole("Admin") ? "Sistem Yöneticisi" : (User.IsInRole("KaliteKontrol") ? "Kalite Sorumlusu" : "Çalışan"))
                            </span>
                        </div>
                    </div>
                </div>
            </header>

            <!-- PAGE WORKSPACE -->
            <main class="p-4 lg:p-8 max-w-[1440px] w-full mx-auto flex flex-col gap-6 lg:gap-8">
                @if (TempData["SuccessMessage"] is string successMessage)
                {
                    <div role="status" class="flex items-center gap-2 p-3 rounded-lg bg-tertiary/10 border border-tertiary/30 text-tertiary text-xs font-medium">
                        <span class="material-symbols-outlined text-[1.125rem]">check_circle</span>
                        <span>@successMessage</span>
                    </div>
                }
                @RenderBody()
            </main>
        </div>

        <script>
            // Mobilde yan menüyü aç/kapat (lg ve üzeri ekranlarda menü her zaman görünür).
            function toggleSidebar(open) {
                const sidebar = document.getElementById('sidebar');
                const overlay = document.getElementById('sidebarOverlay');
                if (!sidebar || !overlay) return;
                const shouldOpen = typeof open === 'boolean' ? open : sidebar.classList.contains('-translate-x-full');
                sidebar.classList.toggle('-translate-x-full', !shouldOpen);
                overlay.classList.toggle('hidden', !shouldOpen);
            }
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') toggleSidebar(false);
            });
        </script>
    }
    else
    {
        <!-- UNAUTHENTICATED SHELL (e.g. Login) -->
        <main class="min-h-screen bg-surface flex items-center justify-center p-4">
            @RenderBody()
        </main>
    }

    @if (User.Identity != null && User.Identity.IsAuthenticated && HostEnv.IsDevelopment())
    {
        <!-- FLOATING DEBUG PERFORMANCE PILL -->
        <div id="perfBadge" class="fixed bottom-4 right-4 z-50 font-mono text-xs select-none">
            <button id="perfToggleBtn" onclick="togglePerfDetails()" 
                    class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-surface-container-low/90 backdrop-blur-md border border-white/[0.08] shadow-lg hover:border-primary/40 transition-all cursor-pointer group">
                <span class="relative flex h-2 w-2">
                    <span id="perfPing" class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
                    <span id="perfDot" class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
                </span>
                <span class="text-white/80 group-hover:text-white font-medium flex items-center gap-1">
                    <span class="material-symbols-outlined text-[14px] text-primary">speed</span>
                    <span id="perfTimeText">-- ms</span>
                </span>
            </button>

            <!-- POPUP DETAILS CARD -->
            <div id="perfPopup" class="hidden absolute bottom-11 right-0 w-72 p-4 rounded-xl bg-surface-container-low border border-white/[0.1] shadow-2xl space-y-3">
                <div class="flex items-center justify-between border-b border-white/[0.06] pb-2">
                    <div class="flex items-center gap-1.5 text-primary text-xs font-semibold">
                        <span class="material-symbols-outlined text-[16px]">timer</span>
                        <span>İşlem Performans Takibi</span>
                    </div>
                    <button onclick="togglePerfDetails()" class="text-outline hover:text-white text-xs p-0.5 cursor-pointer">✕</button>
                </div>
                <div class="space-y-2 text-[11px]">
                    <div class="flex items-center justify-between">
                        <span class="text-outline">Sunucu İşleme:</span>
                        <span id="perfServerTime" class="text-white font-semibold">-- ms</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-outline">Sayfa Oluşumu (DOM):</span>
                        <span id="perfDomTime" class="text-white font-semibold">-- ms</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-outline">Toplam Yanıt Süresi:</span>
                        <span id="perfTotalTime" class="text-primary font-semibold">-- ms</span>
                    </div>
                    <div class="pt-2 border-t border-white/[0.04] text-[10px] text-outline flex items-center justify-between">
                        <span>Terminal Log:</span>
                        <span class="text-emerald-400 font-mono">[PERF] Aktif</span>
                    </div>
                </div>
            </div>
        </div>

        <script>
            window.addEventListener('load', function() {
                setTimeout(function() {
                    let serverMs = null;
                    const navEntries = performance.getEntriesByType('navigation');
                    if (navEntries && navEntries.length > 0) {
                        const nav = navEntries[0];
                        const serverTiming = nav.serverTiming;
                        if (serverTiming && serverTiming.length > 0) {
                            const totalTiming = serverTiming.find(t => t.name === 'total' || t.name === 'app');
                            if (totalTiming) serverMs = Math.round(totalTiming.duration);
                        }
                        if (!serverMs) {
                            serverMs = Math.max(1, Math.round(nav.responseStart - nav.requestStart));
                        }
                        const domTime = Math.max(1, Math.round(nav.domContentLoadedEventEnd - nav.responseEnd));
                        const totalLoad = Math.max(1, Math.round(nav.duration));

                        const timeText = document.getElementById('perfTimeText');
                        const serverText = document.getElementById('perfServerTime');
                        const domText = document.getElementById('perfDomTime');
                        const totalText = document.getElementById('perfTotalTime');
                        const dot = document.getElementById('perfDot');
                        const ping = document.getElementById('perfPing');

                        if (timeText) timeText.textContent = `${serverMs} ms`;
                        if (serverText) serverText.textContent = `${serverMs} ms`;
                        if (domText) domText.textContent = `${domTime} ms`;
                        if (totalText) totalText.textContent = `${totalLoad} ms`;

                        if (serverMs >= 800) {
                            if (dot) dot.className = 'relative inline-flex rounded-full h-2 w-2 bg-rose-500';
                            if (ping) ping.className = 'animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-500 opacity-75';
                        } else if (serverMs >= 300) {
                            if (dot) dot.className = 'relative inline-flex rounded-full h-2 w-2 bg-amber-400';
                            if (ping) ping.className = 'animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75';
                        }
                    }
                }, 150);
            });

            function togglePerfDetails() {
                const popup = document.getElementById('perfPopup');
                if (popup) popup.classList.toggle('hidden');
            }
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
