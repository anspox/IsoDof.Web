@model IsoDof.Web.Models.Entities.DofTemplate

@{
    ViewData["Title"] = "Yeni DÖF Şablonu";
}

<div class="max-w-3xl mx-auto pb-16 text-on-surface">
    <header class="flex items-center gap-3 mb-6">
        <a asp-action="Index" class="font-code-sm text-xs text-outline hover:text-primary transition-colors flex items-center gap-1">
            <span class="material-symbols-outlined text-sm">arrow_back</span>
            <span>Şablonlar</span>
        </a>
        <span class="text-outline/40">/</span>
        <h1 class="text-xl font-bold text-on-surface tracking-tight">Yeni Şablon</h1>
    </header>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
    {
        <div class="mb-6 p-4 rounded-xl bg-error-container/20 border border-error/30 text-error text-xs flex flex-col gap-1">
            <div asp-validation-summary="All" class="pl-1 text-on-surface"></div>
        </div>
    }

    <form asp-action="Create" method="post" class="bg-surface-container-low border border-outline-variant/20 rounded-2xl p-6 shadow-sm flex flex-col gap-5">
        @Html.AntiForgeryToken()

        <div>
            <label class="block text-xs font-semibold text-on-surface mb-2 uppercase tracking-wider" asp-for="Name">Şablon Adı <span class="text-error">*</span></label>
            <input asp-for="Name" placeholder="Örn: Kalibrasyon Gecikmesi"
                   class="w-full bg-surface-container border border-outline-variant/40 px-4 py-2.5 rounded-xl text-on-surface text-sm focus:outline-none focus:border-primary transition-all" />
            <span asp-validation-for="Name" class="text-error text-xs mt-1 block"></span>
        </div>

        <div>
            <label class="block text-xs font-semibold text-on-surface mb-2 uppercase tracking-wider" asp-for="TitleTemplate">Başlık Şablonu <span class="text-error">*</span></label>
            <input asp-for="TitleTemplate" placeholder="DÖF açılırken Başlık alanına otomatik yazılacak metin"
                   class="w-full bg-surface-container border border-outline-variant/40 px-4 py-2.5 rounded-xl text-on-surface text-sm focus:outline-none focus:border-primary transition-all" />
            <span asp-validation-for="TitleTemplate" class="text-error text-xs mt-1 block"></span>
        </div>

        <div>
            <label class="block text-xs font-semibold text-on-surface mb-2 uppercase tracking-wider" asp-for="DescriptionTemplate">Açıklama Şablonu <span class="text-error">*</span></label>
            <textarea asp-for="DescriptionTemplate" rows="5"
                      class="w-full bg-surface-container border border-outline-variant/40 p-3.5 rounded-xl text-xs sm:text-sm text-on-surface focus:outline-none focus:border-primary transition-all"></textarea>
            <span asp-validation-for="DescriptionTemplate" class="text-error text-xs mt-1 block"></span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
                <label class="block text-xs text-on-surface-variant mb-1.5 font-medium uppercase tracking-wider" asp-for="Type">Tür <span class="text-error">*</span></label>
                <select asp-for="Type" asp-items="Html.GetEnumSelectList<IsoDof.Web.Models.Entities.Enums.DofType>()"
                        class="w-full bg-surface-container border border-outline-variant/40 text-on-surface text-xs rounded-xl px-3 py-2.5 focus:outline-none focus:border-primary transition-all"></select>
            </div>
            <div>
                <label class="block text-xs text-on-surface-variant mb-1.5 font-medium uppercase tracking-wider" asp-for="Source">Kaynak <span class="text-error">*</span></label>
                <select asp-for="Source" asp-items="Html.GetEnumSelectList<IsoDof.Web.Models.Entities.Enums.DofSource>()"
                        class="w-full bg-surface-container border border-outline-variant/40 text-on-surface text-xs rounded-xl px-3 py-2.5 focus:outline-none focus:border-primary transition-all"></select>
            </div>
            <div>
                <label class="block text-xs text-on-surface-variant mb-1.5 font-medium uppercase tracking-wider" asp-for="DepartmentId">Departman</label>
                <select asp-for="DepartmentId" asp-items="ViewBag.Departments"
                        class="w-full bg-surface-container border border-outline-variant/40 text-on-surface text-xs rounded-xl px-3 py-2.5 focus:outline-none focus:border-primary transition-all">
                    <option value="">-- Tüm Departmanlar --</option>
                </select>
            </div>
        </div>

        <label class="flex items-center gap-2 cursor-pointer">
            <input asp-for="IsActive" type="checkbox" class="accent-primary h-4 w-4 rounded" />
            <span class="text-xs text-on-surface">Aktif (çalışanlar Create ekranında görebilsin)</span>
        </label>

        <div class="flex items-center justify-between pt-2 border-t border-outline-variant/20">
            <a asp-action="Index" class="px-4 py-2 rounded-xl text-xs font-medium text-on-surface-variant hover:text-on-surface transition-colors border border-outline-variant/30">Vazgeç</a>
            <button type="submit" class="inline-flex items-center gap-2 bg-primary hover:bg-primary-container text-on-primary px-6 py-2.5 rounded-xl text-sm font-semibold transition-all shadow-md">
                <span class="material-symbols-outlined text-base">save</span>
                <span>Şablonu Kaydet</span>
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
