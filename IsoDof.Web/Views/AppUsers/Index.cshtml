@model IEnumerable<IsoDof.Web.Models.Entities.AppUser>

@{
    ViewData["Title"] = "Kullanıcılar ve Roller";
    var userList = Model.ToList();
    var totalUsers = userList.Count;
    var qaLeads = userList.Count(u => u.Role == IsoDof.Web.Models.Entities.Enums.UserRole.KaliteKontrol);
    var adminCount = userList.Count(u => u.Role == IsoDof.Web.Models.Entities.Enums.UserRole.Admin);
    var standardCount = userList.Count(u => u.Role == IsoDof.Web.Models.Entities.Enums.UserRole.Kullanici);
    var totalDepts = (int)(ViewBag.TotalDepartmentsCount ?? 0);
}

<div class="flex flex-col w-full space-y-8">
    <!-- BAŞLIK -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <span class="px-2 py-0.5 rounded text-[10px] font-mono tracking-wide uppercase bg-secondary/10 text-secondary border border-secondary/20">Erişim Kontrolü</span>
                <span class="text-xs text-outline font-mono">Rol Bazlı Yetkilendirme</span>
            </div>
            <h1 class="text-2xl font-semibold text-white tracking-tight">Kullanıcı Yönetimi</h1>
            <p class="text-xs text-outline mt-0.5">Personel bilgilerini, erişim rollerini ve departman atamalarını yönetin</p>
        </div>
        <div class="flex items-center gap-3">
            <div class="relative w-64">
                <span class="material-symbols-outlined absolute left-3 top-2.5 text-outline text-[16px]">search</span>
                <input id="userSearchInput"
                       class="w-full h-9 pl-9 pr-3 text-xs bg-surface-container-low border border-white/[0.06] text-white placeholder:text-outline rounded-lg focus:outline-none focus:border-primary/40 transition-colors"
                       placeholder="Kullanıcı, e-posta veya rol ara..."
                       type="text"/>
            </div>
            <a asp-action="Import"
               class="h-9 px-4 flex items-center gap-1.5 rounded-lg bg-surface-container border border-white/[0.08] text-on-surface font-medium text-xs hover:bg-surface-container-high transition-colors text-decoration-none">
                <span class="material-symbols-outlined text-[16px]">upload_file</span>
                <span>Toplu İçe Aktar</span>
            </a>
            <a asp-action="Create"
               class="h-9 px-4 flex items-center gap-1.5 rounded-lg bg-primary text-on-primary font-medium text-xs hover:bg-primary-container transition-colors shadow-sm shadow-primary/20 text-decoration-none">
                <span class="material-symbols-outlined text-[16px]">person_add</span>
                <span>Yeni Kullanıcı</span>
            </a>
        </div>
    </div>

    <!-- METRİKLER -->
    <section class="grid grid-cols-1 md:grid-cols-3 gap-4 border border-white/[0.05] rounded-xl bg-surface-container-low/60 p-1">
        <div class="p-5 flex flex-col justify-center">
            <span class="text-xs text-outline font-medium">Toplam Personel</span>
            <div class="mt-2 flex items-baseline gap-2">
                <span class="text-3xl font-semibold text-white tracking-tight">@totalUsers</span>
                <span class="text-xs text-secondary font-medium">@totalDepts departman</span>
            </div>
        </div>
        <div class="p-5 flex flex-col justify-center md:border-l border-white/[0.04]">
            <span class="text-xs text-outline font-medium">Kalite Sorumluları</span>
            <div class="mt-2 flex items-baseline gap-2">
                <span class="text-3xl font-semibold text-white tracking-tight">@qaLeads</span>
                <span class="text-xs text-primary font-medium">Alan değerlendiricileri</span>
            </div>
        </div>
        <div class="p-5 flex flex-col justify-center md:border-l border-white/[0.04]">
            <span class="text-xs text-outline font-medium">Yöneticiler</span>
            <div class="mt-2 flex items-baseline gap-2">
                <span class="text-3xl font-semibold text-white tracking-tight">@adminCount</span>
                <span class="text-xs text-outline font-mono">Sistem yöneticileri</span>
            </div>
        </div>
    </section>

    <!-- SEKMELER -->
    <div class="flex items-center justify-between pt-1">
        <div class="flex items-center p-1 bg-surface-container-low border border-white/[0.05] rounded-lg">
            <a asp-controller="Departments" asp-action="Index"
               class="px-3.5 py-1.5 rounded-md text-outline hover:text-white text-xs font-medium transition-colors text-decoration-none flex items-center gap-1.5">
                <span class="material-symbols-outlined text-[14px]">corporate_fare</span>
                <span>Departmanlar</span>
            </a>
            <a asp-controller="AppUsers" asp-action="Index"
               class="px-3.5 py-1.5 rounded-md bg-white/[0.06] text-white text-xs font-medium transition-colors shadow-sm text-decoration-none flex items-center gap-1.5">
                <span class="material-symbols-outlined text-[14px] text-primary">group</span>
                <span>Kullanıcılar &amp; Roller</span>
            </a>
        </div>
        <div class="text-xs text-outline font-mono" id="entryCount">@totalUsers kayıt</div>
    </div>

    <!-- KULLANICI LİSTESİ -->
    <section class="rounded-xl border border-white/[0.05] bg-surface-container-low/40 overflow-hidden">
        <div class="overflow-x-auto w-full">
            <table class="w-full text-left" id="usersTable">
                <thead>
                    <tr class="border-b border-white/[0.04] text-[11px] font-medium text-outline uppercase tracking-wider">
                        <th class="py-3.5 px-6 font-medium">Personel</th>
                        <th class="py-3.5 px-6 font-medium">Sicil No</th>
                        <th class="py-3.5 px-6 font-medium">E-posta Adresi</th>
                        <th class="py-3.5 px-6 font-medium">Departman</th>
                        <th class="py-3.5 px-6 font-medium">Sistem Rolü</th>
                        <th class="py-3.5 px-6 font-medium text-right">İşlem</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-white/[0.03]" id="userTableBody">
                    @if (!userList.Any())
                    {
                        <tr>
                            <td colspan="6" class="py-12 text-center text-outline">
                                <span class="material-symbols-outlined text-4xl block mx-auto mb-2 opacity-40">group</span>
                                <p class="text-sm">Henüz bir kullanıcı kaydı bulunamadı.</p>
                                <a asp-action="Create" class="mt-3 inline-flex items-center gap-1.5 text-xs text-primary hover:underline">
                                    <span class="material-symbols-outlined text-[14px]">person_add</span> Yeni Kullanıcı Ekle
                                </a>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var user in userList)
                        {
                            var initial = !string.IsNullOrEmpty(user.FullName) ? user.FullName.Substring(0, 1).ToUpper() : "U";
                            <tr class="hover:bg-white/[0.02] transition-colors group user-row">
                                <td class="py-4 px-6">
                                    <div class="flex items-center gap-3">
                                        <div class="w-8 h-8 rounded-full bg-surface-container-highest border border-white/10 text-primary flex items-center justify-center font-bold text-xs">
                                            @initial
                                        </div>
                                        <div>
                                            <div class="text-sm font-medium text-white group-hover:text-primary transition-colors user-name">
                                                @user.FullName
                                            </div>
                                            <div class="text-[11px] text-outline">ID: #@user.Id.ToString("D3")</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-4 px-6 whitespace-nowrap user-sicil">
                                    <span class="font-mono text-xs @(string.IsNullOrEmpty(user.SicilNo) ? "text-outline/50" : "text-on-surface-variant")">
                                        @(string.IsNullOrEmpty(user.SicilNo) ? "—" : user.SicilNo)
                                    </span>
                                </td>
                                <td class="py-4 px-6 whitespace-nowrap">
                                    <span class="font-mono text-xs text-on-surface-variant user-email">@user.Email</span>
                                </td>
                                <td class="py-4 px-6 whitespace-nowrap user-dept">
                                    @if (user.Department != null)
                                    {
                                        <div class="flex items-center gap-2">
                                            <span class="w-1.5 h-1.5 rounded-full bg-secondary/80"></span>
                                            <span class="text-xs text-on-surface">@user.Department.Name</span>
                                            @if (!string.IsNullOrEmpty(user.Department.Code))
                                            {
                                                <span class="font-mono text-[10px] text-outline bg-white/[0.03] px-1.5 py-0.5 rounded">@user.Department.Code</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-outline italic">Departman Yok</span>
                                    }
                                </td>
                                <td class="py-4 px-6 whitespace-nowrap user-role">
                                    @if (user.Role == IsoDof.Web.Models.Entities.Enums.UserRole.Admin)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[11px] font-medium bg-error-container/20 text-error border border-error/30">
                                            <span class="w-1.5 h-1.5 rounded-full bg-error"></span>
                                            <span>Yönetici</span>
                                        </span>
                                    }
                                    else if (user.Role == IsoDof.Web.Models.Entities.Enums.UserRole.KaliteKontrol)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[11px] font-medium bg-primary/10 text-primary border border-primary/20">
                                            <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
                                            <span>Kalite Kontrol</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[11px] font-medium bg-white/[0.04] text-on-surface-variant border border-white/[0.06]">
                                            <span class="w-1.5 h-1.5 rounded-full bg-outline"></span>
                                            <span>Kullanıcı</span>
                                        </span>
                                    }
                                </td>
                                <td class="py-4 px-6 whitespace-nowrap text-right">
                                    <div class="flex items-center justify-end gap-1">
                                        <a asp-action="Edit" asp-route-id="@user.Id"
                                           title="Düzenle"
                                           class="text-outline hover:text-white p-1.5 rounded-md hover:bg-white/[0.04] transition-colors inline-flex items-center justify-center">
                                            <span class="material-symbols-outlined text-[18px]">edit</span>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@user.Id"
                                           title="Sil"
                                           class="text-outline hover:text-error p-1.5 rounded-md hover:bg-error/10 transition-colors inline-flex items-center justify-center">
                                            <span class="material-symbols-outlined text-[18px]">delete</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <!-- ALT BİLGİ -->
        <div class="px-6 py-3 border-t border-white/[0.04] flex items-center justify-between text-xs text-outline">
            <span id="footerCount">@totalUsers kayıt gösteriliyor</span>
            <div class="flex items-center gap-1 font-mono text-[10px] text-outline/60">
                <span>NISO Erişim Kontrolü v4.2</span>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        document.getElementById('userSearchInput')?.addEventListener('input', function(e) {
            const query = e.target.value.toLowerCase().trim();
            const rows = document.querySelectorAll('#userTableBody .user-row');
            let visible = 0;
            rows.forEach(row => {
                const name = row.querySelector('.user-name')?.textContent.toLowerCase() || '';
                const email = row.querySelector('.user-email')?.textContent.toLowerCase() || '';
                const dept = row.querySelector('.user-dept')?.textContent.toLowerCase() || '';
                const role = row.querySelector('.user-role')?.textContent.toLowerCase() || '';
                const sicil = row.querySelector('.user-sicil')?.textContent.toLowerCase() || '';
                if (name.includes(query) || email.includes(query) || dept.includes(query) || role.includes(query) || sicil.includes(query)) {
                    row.style.display = '';
                    visible++;
                } else {
                    row.style.display = 'none';
                }
            });
            const entryCount = document.getElementById('entryCount');
            const footerCount = document.getElementById('footerCount');
            if (entryCount) entryCount.textContent = `${visible} kayıt`;
            if (footerCount) footerCount.textContent = `${rows.length} kayıttan ${visible} gösteriliyor`;
        });
    </script>
}
