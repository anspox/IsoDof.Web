@model IsoDof.Web.Models.Entities.Dof

@{
    ViewData["Title"] = $"DÖF-#{Model.Id:D3} Detay";
    var completedActions = Model.Actions.Count(a => a.IsCompleted);
    var totalActions = Model.Actions.Count;
    var actionRate = totalActions > 0 ? (completedActions * 100 / totalActions) : 100;
}

<div class="max-w-[1360px] mx-auto flex flex-col gap-8 text-on-surface">
    @if (TempData["ErrorMessage"] is string detailsError)
    {
        <div role="alert" class="flex items-center gap-2 p-3 rounded-lg bg-error-container/20 border border-error/30 text-error text-xs font-medium">
            <span class="material-symbols-outlined text-[1.125rem]">error</span>
            <span>@detailsError</span>
        </div>
    }

    <!-- Breadcrumbs & Dossier Hero Header -->
    <section class="flex flex-col gap-4">
        <!-- Breadcrumb & Tag Row -->
        <div class="flex items-center gap-2 text-xs font-mono text-outline">
            <a asp-action="Index" class="hover:text-secondary transition-colors">DÖF Listesi</a>
            <span class="text-white/20">/</span>
            <span class="text-primary font-semibold">DÖF-@Model.Id.ToString("D3")</span>
            <span class="text-white/20">·</span>
            <span class="text-on-surface-variant">ISO 9001 §8.5.2</span>
        </div>

        <!-- Title, Badges & Action Buttons -->
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6 pb-6 border-b border-white/[0.06]">
            <div class="flex flex-col gap-3 max-w-3xl">
                <h1 class="font-display text-3xl sm:text-4xl font-bold tracking-tight text-white leading-tight">
                    @Model.Title
                </h1>
                <div class="flex flex-wrap items-center gap-2.5 text-xs">
                    @if (Model.IsOverdue)
                    {
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-error/10 text-error border border-error/20 font-medium tracking-wide">
                            <span class="w-1.5 h-1.5 rounded-full bg-error animate-ping"></span>
                            Kritik Önem (Gecikmiş)
                        </span>
                    }
                    else if (Model.Type == IsoDof.Web.Models.Entities.Enums.DofType.Duzeltici)
                    {
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/20 font-medium tracking-wide">
                            <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                            Düzeltici Faaliyet
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-primary/10 text-primary border border-primary/25 font-medium tracking-wide">
                            <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
                            Önleyici Faaliyet
                        </span>
                    }

                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-secondary/10 text-secondary border border-secondary/25 font-medium tracking-wide">
                        Durum: @Model.Status
                    </span>

                    <span class="text-outline font-mono text-[11px] ml-1">
                        Oluşturulma: @Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                    </span>
                </div>
            </div>

            <!-- Clean Modern Action Group -->
            <div class="flex items-center gap-3 shrink-0">
                <a asp-action="Index" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface border border-white/[0.08] text-xs font-medium transition-all">
                    <span class="material-symbols-outlined text-[1.125rem] text-outline">arrow_back</span>
                    <span>Listeye Dön</span>
                </a>
                @if (!Model.IsArchived)
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface border border-white/[0.08] text-xs font-medium transition-all">
                        <span class="material-symbols-outlined text-[1.125rem] text-outline">edit</span>
                        <span>Düzenle</span>
                    </a>
                }
                <a asp-action="ExportPdf" asp-route-id="@Model.Id" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-primary text-surface font-semibold text-xs hover:bg-primary-dim shadow-sm shadow-primary/10 transition-all">
                    <span class="material-symbols-outlined text-[1.125rem]">file_download</span>
                    <span>PDF İndir</span>
                </a>
            </div>
        </div>

        @if (!Model.IsArchived)
        {
            var status = Model.Status;
            <!-- Quick status action buttons -->
            <div class="flex flex-wrap items-center gap-2 pt-1">
                @if (status == IsoDof.Web.Models.Entities.Enums.DofStatus.Acik)
                {
                    <form asp-action="QuickStatus" method="post" class="inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="newStatus" value="@IsoDof.Web.Models.Entities.Enums.DofStatus.Incelemede" />
                        <button type="submit" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-primary/10 hover:bg-primary/20 text-primary border border-primary/30 text-xs font-semibold transition-all">
                            <span class="material-symbols-outlined text-[1rem]">visibility</span>
                            <span>İncelemeye Al</span>
                        </button>
                    </form>
                    <form asp-action="QuickStatus" method="post" class="inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="newStatus" value="@IsoDof.Web.Models.Entities.Enums.DofStatus.Reddedildi" />
                        <button type="submit" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-error/10 hover:bg-error/20 text-error border border-error/30 text-xs font-semibold transition-all">
                            <span class="material-symbols-outlined text-[1rem]">block</span>
                            <span>Reddet</span>
                        </button>
                    </form>
                }
                else if (status == IsoDof.Web.Models.Entities.Enums.DofStatus.Incelemede)
                {
                    <form asp-action="QuickStatus" method="post" class="inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="newStatus" value="@IsoDof.Web.Models.Entities.Enums.DofStatus.FaaliyetPlanlandi" />
                        <button type="submit" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-primary/10 hover:bg-primary/20 text-primary border border-primary/30 text-xs font-semibold transition-all">
                            <span class="material-symbols-outlined text-[1rem]">fact_check</span>
                            <span>Faaliyete Geçir</span>
                        </button>
                    </form>
                    <form asp-action="QuickStatus" method="post" class="inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="newStatus" value="@IsoDof.Web.Models.Entities.Enums.DofStatus.Reddedildi" />
                        <button type="submit" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-error/10 hover:bg-error/20 text-error border border-error/30 text-xs font-semibold transition-all">
                            <span class="material-symbols-outlined text-[1rem]">block</span>
                            <span>Reddet</span>
                        </button>
                    </form>
                }
                else if (status == IsoDof.Web.Models.Entities.Enums.DofStatus.FaaliyetPlanlandi)
                {
                    var allActionsDone = Model.Actions.Count > 0 && Model.Actions.All(a => a.IsCompleted);
                    <form asp-action="QuickStatus" method="post" class="inline" title="@(allActionsDone ? "" : "Tüm faaliyet adımları tamamlanmadan kapatılamaz")">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="newStatus" value="@IsoDof.Web.Models.Entities.Enums.DofStatus.Kapatildi" />
                        <button type="submit" @(allActionsDone ? "" : "disabled")
                                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold transition-all border
                                       @(allActionsDone ? "bg-tertiary/10 hover:bg-tertiary/20 text-tertiary border-tertiary/30 cursor-pointer" : "bg-surface-container text-outline/50 border-outline-variant/20 cursor-not-allowed")">
                            <span class="material-symbols-outlined text-[1rem]">task_alt</span>
                            <span>Kapatmayı Onayla</span>
                        </button>
                    </form>
                }
                else if (status == IsoDof.Web.Models.Entities.Enums.DofStatus.Kapatildi || status == IsoDof.Web.Models.Entities.Enums.DofStatus.Reddedildi)
                {
                    var reopenTo = status == IsoDof.Web.Models.Entities.Enums.DofStatus.Kapatildi
                        ? IsoDof.Web.Models.Entities.Enums.DofStatus.Incelemede
                        : IsoDof.Web.Models.Entities.Enums.DofStatus.Acik;
                    <form asp-action="QuickStatus" method="post" class="inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="newStatus" value="@reopenTo" />
                        <button type="submit" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-secondary/10 hover:bg-secondary/20 text-secondary border border-secondary/30 text-xs font-semibold transition-all">
                            <span class="material-symbols-outlined text-[1rem]">restart_alt</span>
                            <span>Yeniden Aç</span>
                        </button>
                    </form>
                }
            </div>
        }
    </section>

    <!-- Key Metrics Strip: Modern Minimalist Stat Counters -->
    <section class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <!-- Metric 1: Faaliyet Durumu -->
        <div class="bg-surface-container-low border border-white/[0.06] rounded-xl p-5 flex flex-col justify-between shadow-sm">
            <span class="text-xs uppercase tracking-wider font-mono text-outline font-medium">Faaliyet Adımları</span>
            <div class="flex items-baseline gap-2 mt-2">
                <span class="font-display text-3xl font-bold text-white tracking-tight">@completedActions / @totalActions</span>
                <span class="text-xs text-primary font-mono font-medium">%@actionRate Tamamlandı</span>
            </div>
            <span class="text-xs text-on-surface-variant mt-1">@(Model.Department?.Name ?? "Genel") Departmanı</span>
        </div>

        <!-- Metric 2: SLA & Termin -->
        <div class="bg-surface-container-low border border-white/[0.06] rounded-xl p-5 flex flex-col justify-between shadow-sm">
            <span class="text-xs uppercase tracking-wider font-mono text-outline font-medium">Termin / SLA Durumu</span>
            <div class="flex items-baseline gap-2 mt-2">
                @if (Model.ClosedAt.HasValue)
                {
                    <span class="font-display text-3xl font-bold text-tertiary tracking-tight">Kapatıldı</span>
                    <span class="text-xs text-tertiary font-mono">Doğrulandı</span>
                }
                else if (Model.IsOverdue)
                {
                    <span class="font-display text-3xl font-bold text-error tracking-tight">Gecikmiş</span>
                    <span class="text-xs text-error font-mono">Termin: @(Model.DueDate?.ToString("dd.MM.yyyy") ?? "-")</span>
                }
                else
                {
                    <span class="font-display text-3xl font-bold text-white tracking-tight">@(Model.DueDate?.ToString("dd.MM.yyyy") ?? "Belirtilmedi")</span>
                    <span class="text-xs text-secondary font-mono">Zamanında</span>
                }
            </div>
            <span class="text-xs text-on-surface-variant mt-1">Denetime uygun izlenebilirlik</span>
        </div>

        <!-- Metric 3: Standart & Değerlendirme -->
        <div class="bg-surface-container-low border border-white/[0.06] rounded-xl p-5 flex flex-col justify-between shadow-sm">
            <span class="text-xs uppercase tracking-wider font-mono text-outline font-medium">Risk &amp; Standart</span>
            <div class="flex items-baseline gap-2 mt-2">
                <span class="font-display text-3xl font-bold text-secondary tracking-tight">@Model.Type</span>
                <span class="text-xs text-outline font-mono">@Model.Source</span>
            </div>
            <span class="text-xs text-on-surface-variant mt-1">ISO 9001:2015 Denetim Hazırlığı</span>
        </div>
    </section>

    <!-- Main Layout Grid: 8 cols Primary, 4 cols Metadata -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- Left Column: Core Investigation Dossier (8 cols) -->
        <div class="lg:col-span-8 flex flex-col gap-8">
            <!-- 1. Executive Summary & Root Cause -->
            <section class="bg-surface-container-low border border-white/[0.06] rounded-xl p-6 sm:p-7 flex flex-col gap-5 shadow-sm">
                <div class="flex items-center justify-between pb-3 border-b border-white/[0.06]">
                    <h2 class="font-display text-base font-semibold text-white tracking-wide flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary text-[1.25rem]">description</span>
                        <span>Problem Tanımı &amp; Kök Neden Bulguları</span>
                    </h2>
                    <span class="text-xs font-mono text-outline">DÖF-@Model.Id.ToString("D3")</span>
                </div>
                <p class="text-sm text-on-surface leading-relaxed whitespace-pre-wrap">
                    @Model.Description
                </p>
                <div class="p-4 rounded-lg bg-surface-container/60 border border-white/[0.04] flex flex-col gap-1.5">
                    <div class="flex items-center gap-2 text-secondary text-xs font-medium uppercase font-mono tracking-wider">
                        <span class="material-symbols-outlined text-[1rem]">account_tree</span>
                        <span>Süreç Özeti &amp; Sınıflandırma</span>
                    </div>
                    <p class="text-xs text-on-surface-variant leading-relaxed">
                        Faaliyet Türü: <strong class="text-white">@Model.Type</strong> •
                        Uygunsuzluk Kaynağı: <strong class="text-white">@Model.Source</strong> •
                        Sorumlu Departman: <strong class="text-white">@(Model.Department?.Name ?? "-")</strong>
                    </p>
                </div>
            </section>

            @if (Model.RootCauseCategory.HasValue || !string.IsNullOrWhiteSpace(Model.RootCauseWhy1) || !string.IsNullOrWhiteSpace(Model.RootCauseAnalysis))
            {
                <!-- 1b. Kök Neden Analizi -->
                <section class="bg-surface-container-low border border-white/[0.06] rounded-xl p-6 sm:p-7 flex flex-col gap-4 shadow-sm">
                    <div class="flex items-center justify-between pb-3 border-b border-white/[0.06]">
                        <h2 class="font-display text-base font-semibold text-white tracking-wide flex items-center gap-2">
                            <span class="material-symbols-outlined text-secondary text-[1.25rem]">account_tree</span>
                            <span>Kök Neden Analizi</span>
                        </h2>
                        @if (Model.RootCauseCategory.HasValue)
                        {
                            <span class="text-xs font-mono px-2 py-0.5 rounded bg-secondary/10 text-secondary border border-secondary/25">@Model.RootCauseCategory (6M)</span>
                        }
                    </div>

                    @{
                        var whys = new[] { Model.RootCauseWhy1, Model.RootCauseWhy2, Model.RootCauseWhy3, Model.RootCauseWhy4, Model.RootCauseWhy5 }
                            .Select((w, i) => (Index: i + 1, Text: w))
                            .Where(x => !string.IsNullOrWhiteSpace(x.Text))
                            .ToList();
                    }
                    @if (whys.Any())
                    {
                        <div class="flex flex-col gap-2 text-xs">
                            @foreach (var why in whys)
                            {
                                <div class="flex items-start gap-2.5">
                                    <span class="shrink-0 w-5 h-5 rounded-full bg-secondary/10 text-secondary border border-secondary/25 flex items-center justify-center text-[10px] font-bold">@why.Index</span>
                                    <span class="text-on-surface leading-relaxed pt-0.5">@why.Text</span>
                                </div>
                            }
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.RootCauseAnalysis))
                    {
                        <p class="text-xs text-on-surface-variant leading-relaxed whitespace-pre-wrap pt-2 border-t border-white/[0.04]">@Model.RootCauseAnalysis</p>
                    }
                </section>
            }

            <!-- 2. Action Plan Checklist -->
            <section class="bg-surface-container-low border border-white/[0.06] rounded-xl p-6 sm:p-7 flex flex-col gap-5 shadow-sm">
                <div class="flex items-center justify-between pb-3 border-b border-white/[0.06]">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary text-[1.25rem]">task_alt</span>
                        <h2 class="font-display text-base font-semibold text-white tracking-wide">Faaliyet Adımları (Aksiyon Planı)</h2>
                    </div>
                    <span class="text-xs font-mono text-primary font-medium">@totalActions adımdan @completedActions tamamlandı (%@actionRate)</span>
                </div>

                @if (!Model.Actions.Any())
                {
                    <div class="py-6 text-center text-xs text-on-surface-variant">
                        Henüz tanımlanmış bir faaliyet adımı bulunmamaktadır.
                    </div>
                }
                else
                {
                    <!-- Task List -->
                    <div class="flex flex-col divide-y divide-white/[0.04]">
                        @foreach (var action in Model.Actions)
                        {
                            <div class="py-3.5 first:pt-0 last:pb-0 flex items-start justify-between gap-4">
                                <div class="flex items-start gap-3">
                                    <span class="material-symbols-outlined @(action.IsCompleted ? "text-tertiary" : "text-secondary") text-[1.125rem] mt-0.5 shrink-0">
                                        @(action.IsCompleted ? "check_circle" : "schedule")
                                    </span>
                                    <div class="flex flex-col">
                                        <span class="text-xs font-medium text-white @(action.IsCompleted ? "line-through opacity-70" : "")">
                                            @action.Description
                                        </span>
                                        <span class="text-[11px] text-outline mt-0.5">
                                            Sorumlu: <strong class="text-on-surface">@(action.ResponsibleUser?.FullName ?? "-")</strong>
                                        </span>
                                    </div>
                                </div>
                                <div class="text-right shrink-0 flex flex-col items-end gap-1.5">
                                    <span class="text-[11px] font-mono @(action.IsCompleted ? "text-tertiary font-medium" : "text-secondary")">
                                        @(action.IsCompleted ? "Tamamlandı" : "İşlemde")
                                    </span>
                                    @if (action.DueDate.HasValue)
                                    {
                                        <span class="text-[10px] block text-outline">Termin: @action.DueDate.Value.ToString("dd.MM")</span>
                                    }
                                    @if (!action.IsCompleted)
                                    {
                                        <form asp-controller="DofActions" asp-action="Complete" asp-route-id="@action.Id" method="post" class="inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="returnUrl" value="@Url.Action("Details", "Dofs", new { id = Model.Id })" />
                                            <button type="submit" class="inline-flex items-center gap-1 px-2 py-1 rounded bg-tertiary/10 hover:bg-tertiary/20 text-tertiary text-[10px] font-semibold border border-tertiary/25 transition-colors cursor-pointer">
                                                <span class="material-symbols-outlined text-[0.8rem]">done</span>
                                                <span>Tamamla</span>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }

                @if (!Model.IsArchived)
                {
                    <!-- Inline quick action add -->
                    <details class="pt-3 border-t border-white/[0.06]">
                        <summary class="cursor-pointer text-xs font-medium text-primary flex items-center gap-1.5 select-none">
                            <span class="material-symbols-outlined text-[1rem]">add_task</span>
                            <span>Yeni Faaliyet Adımı Ekle</span>
                        </summary>
                        <form asp-controller="DofActions" asp-action="Create" method="post" class="mt-3 flex flex-col gap-2.5">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="DofId" value="@Model.Id" />
                            <input type="hidden" name="returnUrl" value="@Url.Action("Details", "Dofs", new { id = Model.Id })" />
                            <input name="Description" required placeholder="Faaliyet / görev tanımı..."
                                   class="w-full bg-surface-container border border-white/[0.08] rounded-lg p-2.5 text-xs text-on-surface placeholder:text-outline focus:outline-none focus:border-primary/50" />
                            <div class="grid grid-cols-2 gap-2.5">
                                <select name="ResponsibleUserId" id="inline-action-responsible"
                                        class="w-full bg-surface-container border border-white/[0.08] rounded-lg p-2.5 text-xs text-on-surface focus:outline-none focus:border-primary/50">
                                    <option value="">-- Sorumlu Seçiniz --</option>
                                </select>
                                <input name="DueDate" type="date" min="@DateTime.UtcNow.ToString("yyyy-MM-dd")"
                                       class="w-full bg-surface-container border border-white/[0.08] rounded-lg p-2.5 text-xs text-on-surface focus:outline-none focus:border-primary/50" />
                            </div>
                            <button type="submit" class="self-start px-3.5 py-1.5 rounded-md bg-primary text-surface font-semibold text-xs hover:opacity-90 transition-colors cursor-pointer">
                                Faaliyet Ekle
                            </button>
                        </form>
                    </details>
                }
            </section>

            @if (Model.Status == IsoDof.Web.Models.Entities.Enums.DofStatus.Kapatildi)
            {
                <!-- 2b. Etkinlik Takibi -->
                <section class="bg-surface-container-low border border-white/[0.06] rounded-xl p-6 sm:p-7 flex flex-col gap-4 shadow-sm">
                    <div class="flex items-center justify-between pb-3 border-b border-white/[0.06]">
                        <h2 class="font-display text-base font-semibold text-white tracking-wide flex items-center gap-2">
                            <span class="material-symbols-outlined text-tertiary text-[1.25rem]">fact_check</span>
                            <span>Etkinlik Takibi &amp; Doğrulama</span>
                        </h2>
                        @{
                            var effResult = Model.EffectivenessResult;
                            var effBadgeClass = effResult == IsoDof.Web.Models.Entities.Enums.EffectivenessResult.KaliciCozuldu ? "bg-tertiary/10 text-tertiary border-tertiary/30"
                                : effResult == IsoDof.Web.Models.Entities.Enums.EffectivenessResult.TekrarEtti ? "bg-error/10 text-error border-error/30"
                                : "bg-secondary/10 text-secondary border-secondary/25";
                        }
                        <span class="text-xs font-mono px-2 py-0.5 rounded border @effBadgeClass">@effResult</span>
                    </div>

                    <p class="text-xs text-on-surface-variant leading-relaxed">
                        Kapanış tarihinden @(30) gün sonra (@(Model.EffectivenessCheckDueDate?.ToString("dd.MM.yyyy") ?? "-")) alınan önlemin kalıcı olup olmadığı doğrulanmalıdır.
                    </p>

                    @if (Model.EffectivenessCheckedAt.HasValue)
                    {
                        <div class="p-3 rounded-lg bg-surface-container/60 border border-white/[0.04] text-xs flex flex-col gap-1">
                            <span class="text-on-surface">
                                <strong>@(Model.EffectivenessCheckedByUser?.FullName ?? "Sistem")</strong> tarafından @Model.EffectivenessCheckedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm") tarihinde değerlendirildi.
                            </span>
                            @if (!string.IsNullOrWhiteSpace(Model.EffectivenessNotes))
                            {
                                <span class="text-on-surface-variant">@Model.EffectivenessNotes</span>
                            }
                        </div>
                    }
                    else
                    {
                        <form asp-action="EvaluateEffectiveness" method="post" class="flex flex-col gap-2.5">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <div class="flex flex-wrap gap-2">
                                <label class="cursor-pointer">
                                    <input type="radio" name="result" value="@IsoDof.Web.Models.Entities.Enums.EffectivenessResult.KaliciCozuldu" class="peer hidden" />
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surface-container border border-outline-variant/30 text-xs text-on-surface-variant peer-checked:bg-tertiary/15 peer-checked:text-tertiary peer-checked:border-tertiary/40 transition-all">
                                        <span class="material-symbols-outlined text-[1rem]">check_circle</span> Kalıcı Çözüldü
                                    </span>
                                </label>
                                <label class="cursor-pointer">
                                    <input type="radio" name="result" value="@IsoDof.Web.Models.Entities.Enums.EffectivenessResult.TekrarEtti" class="peer hidden" />
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surface-container border border-outline-variant/30 text-xs text-on-surface-variant peer-checked:bg-error/15 peer-checked:text-error peer-checked:border-error/40 transition-all">
                                        <span class="material-symbols-outlined text-[1rem]">replay</span> Tekrar Etti
                                    </span>
                                </label>
                            </div>
                            <textarea name="notes" rows="2" placeholder="Doğrulama notu (opsiyonel)..."
                                      class="w-full bg-surface-container border border-white/[0.08] rounded-lg p-2.5 text-xs text-on-surface placeholder:text-outline focus:outline-none focus:border-primary/50 resize-none"></textarea>
                            <button type="submit" class="self-start px-3.5 py-1.5 rounded-md bg-tertiary text-surface font-semibold text-xs hover:opacity-90 transition-colors cursor-pointer">
                                Değerlendirmeyi Kaydet
                            </button>
                        </form>
                    }
                </section>
            }

            <!-- 3. Audit Trail Activity (Durum Geçmişi) -->
            <section class="bg-surface-container-low border border-white/[0.06] rounded-xl p-6 sm:p-7 flex flex-col gap-4 shadow-sm">
                <div class="flex items-center justify-between pb-3 border-b border-white/[0.06]">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-secondary text-[1.25rem]">history_edu</span>
                        <h2 class="font-display text-base font-semibold text-white tracking-wide">Denetim İzi &amp; Durum Geçmişi</h2>
                    </div>
                    <span class="text-xs font-mono text-outline">Denetim Kaydı</span>
                </div>

                @if (!Model.StatusHistory.Any())
                {
                    <div class="py-4 text-xs text-on-surface-variant text-center">Henüz durum değişikliği kaydı yok.</div>
                }
                else
                {
                    <div class="flex flex-col divide-y divide-white/[0.04] text-xs">
                        @foreach (var h in Model.StatusHistory.OrderByDescending(x => x.ChangedAt))
                        {
                            <div class="py-2.5 flex items-center justify-between gap-4">
                                <div class="flex items-center gap-3">
                                    <span class="font-mono text-outline text-[11px] w-24">@h.ChangedAt.ToLocalTime().ToString("dd.MM, HH:mm")</span>
                                    <span class="text-on-surface font-medium">
                                        @(h.OldStatus.HasValue ? $"{h.OldStatus} → " : "")<strong class="text-primary">@h.NewStatus</strong>
                                        @if (!string.IsNullOrEmpty(h.Note))
                                        {
                                            <span class="text-outline ml-1">(@h.Note)</span>
                                        }
                                    </span>
                                </div>
                                <span class="text-on-surface-variant font-mono text-[11px]">@(h.ChangedByUser?.FullName ?? "Sistem")</span>
                            </div>
                        }
                    </div>
                }
            </section>

            <!-- 4. Review & Discussion Thread (Yorumlar) -->
            <section class="bg-surface-container-low border border-white/[0.06] rounded-xl p-6 sm:p-7 flex flex-col gap-5 shadow-sm">
                <div class="flex items-center justify-between pb-3 border-b border-white/[0.06]">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary text-[1.25rem]">forum</span>
                        <h2 class="font-display text-base font-semibold text-white tracking-wide">İnceleme, Değerlendirme &amp; Yorumlar</h2>
                    </div>
                    <span class="text-xs font-mono text-outline">@Model.Comments.Count Yorum / İmza</span>
                </div>

                <!-- Existing comments -->
                @if (!Model.Comments.Any())
                {
                    <div class="py-6 text-center text-xs text-on-surface-variant">
                        Henüz yorum yapılmamış. İlk değerlendirmeyi aşağıdan ekleyebilirsiniz.
                    </div>
                }
                else
                {
                    <div class="flex flex-col gap-3">
                        @foreach (var comment in Model.Comments)
                        {
                            <div class="p-4 rounded-lg bg-surface-container/60 border border-white/[0.04] flex flex-col gap-2">
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center gap-3">
                                        <div class="w-7 h-7 rounded-full bg-primary/10 border border-primary/20 flex items-center justify-center text-primary font-bold text-xs">
                                            @(comment.AuthorUser?.FullName?.Length > 0 ? comment.AuthorUser.FullName.Substring(0, 1).ToUpper() : "U")
                                        </div>
                                        <div>
                                            <span class="text-xs font-medium text-white block">@(comment.AuthorUser?.FullName ?? "Kullanıcı")</span>
                                            <span class="text-[11px] text-outline font-mono">@comment.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy, HH:mm")</span>
                                        </div>
                                    </div>
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-mono text-primary bg-primary/10 border border-primary/20">
                                        <span class="material-symbols-outlined text-[0.75rem]">verified</span>
                                        Doğrulandı
                                    </span>
                                </div>
                                <p class="text-xs text-on-surface-variant leading-relaxed pl-10 whitespace-pre-wrap">
                                    @comment.Text
                                </p>
                            </div>
                        }
                    </div>
                }

                <!-- Quick Note Input -->
                <form asp-action="AddComment" asp-controller="Dofs" method="post" class="flex flex-col gap-2.5 pt-2 border-t border-white/[0.06]">
                    <input type="hidden" name="dofId" value="@Model.Id" />
                    <textarea name="text" rows="2" placeholder="DÖF hakkında teknik not, mevzuat görüşü veya inceleme sonucu ekleyin..." required
                              class="w-full bg-surface-container border border-white/[0.08] rounded-lg p-3 text-xs text-on-surface placeholder:text-outline focus:outline-none focus:border-primary/50 focus:ring-1 focus:ring-primary/20 resize-none transition-colors"></textarea>
                    <div class="flex items-center justify-between">
                        <span class="text-[11px] text-outline font-mono">Kayıtlar sistem denetim günlüğüne işlenir</span>
                        <button type="submit" class="px-3.5 py-1.5 rounded-md bg-secondary text-surface font-semibold text-xs hover:bg-white transition-colors cursor-pointer">
                            Yorumu Kaydet
                        </button>
                    </div>
                </form>
            </section>
        </div>

        <!-- Right Column: Minimal Sidebar Metadata & Evidence (4 cols) -->
        <aside class="lg:col-span-4 flex flex-col gap-6">
            <!-- Dossier Metadata Card -->
            <section class="bg-surface-container-low border border-white/[0.06] rounded-xl p-6 flex flex-col gap-5 shadow-sm">
                <h2 class="font-display text-sm font-semibold uppercase tracking-wider text-outline pb-2 border-b border-white/[0.06]">
                    Kayıt Bilgileri
                </h2>

                <!-- Lead Assignee with clean avatar -->
                <div class="flex flex-col gap-2">
                    <span class="text-[11px] uppercase tracking-wider font-mono text-outline">Atanan Sorumlu</span>
                    <div class="flex items-center gap-3 p-2.5 rounded-lg bg-surface-container/60 border border-white/[0.04]">
                        <div class="w-9 h-9 rounded-full bg-primary/20 text-primary font-bold text-xs flex items-center justify-center ring-1 ring-white/10">
                            @(Model.AssignedToUser?.FullName?.Length > 0 ? Model.AssignedToUser.FullName.Substring(0, 1).ToUpper() : "?")
                        </div>
                        <div class="flex flex-col">
                            <span class="text-xs font-semibold text-white">@(Model.AssignedToUser?.FullName ?? "Atanmadı")</span>
                            <span class="text-[11px] text-primary font-mono">Sorumlu Uzman</span>
                        </div>
                    </div>
                </div>

                <!-- Key attributes -->
                <div class="flex flex-col divide-y divide-white/[0.04] text-xs">
                    <div class="py-2.5 flex items-center justify-between">
                        <span class="text-outline">Departman</span>
                        <span class="text-on-surface font-medium">@(Model.Department?.Name ?? "-")</span>
                    </div>
                    <div class="py-2.5 flex items-center justify-between">
                        <span class="text-outline">Açan Personel</span>
                        <span class="text-secondary font-medium">@(Model.CreatedByUser?.FullName ?? "-")</span>
                    </div>
                    <div class="py-2.5 flex items-center justify-between">
                        <span class="text-outline">Termin Tarihi (SLA)</span>
                        <span class="@(Model.IsOverdue ? "text-error font-bold" : "text-white") font-mono font-medium">
                            @(Model.DueDate?.ToString("dd.MM.yyyy") ?? "—")
                        </span>
                    </div>
                    @if (Model.ClosedAt.HasValue)
                    {
                        <div class="py-2.5 flex items-center justify-between">
                            <span class="text-outline">Kapanış Tarihi</span>
                            <span class="text-tertiary font-mono">@Model.ClosedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                        </div>
                    }
                    @if (Model.IsArchived)
                    {
                        <div class="py-2.5 flex flex-col gap-1 text-outline">
                            <div class="flex items-center justify-between text-error font-semibold">
                                <span>Arşivlendi</span>
                                <span>@Model.ArchivedAt?.ToLocalTime().ToString("dd.MM.yyyy")</span>
                            </div>
                            <span class="text-[11px]">Neden: @(Model.ArchiveReason ?? "-")</span>
                        </div>
                    }
                </div>

                <!-- Current Status Box -->
                <div class="flex flex-col gap-1.5 pt-1">
                    <span class="text-[11px] uppercase tracking-wider font-mono text-outline">Mevcut Aşama</span>
                    <div class="w-full bg-surface-container border border-white/[0.08] rounded-lg px-3 py-2 text-xs text-primary font-semibold flex items-center justify-between">
                        <span>@Model.Status</span>
                        <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
                    </div>
                </div>
            </section>

            <!-- Evidence & Attachments Card -->
            <section class="bg-surface-container-low border border-white/[0.06] rounded-xl p-6 flex flex-col gap-4 shadow-sm">
                <div class="flex items-center justify-between pb-2 border-b border-white/[0.06]">
                    <h2 class="font-display text-sm font-semibold uppercase tracking-wider text-outline">
                        Ekler &amp; Kanıtlar
                    </h2>
                    <span class="text-[11px] font-mono text-outline">@Model.Attachments.Count Dosya</span>
                </div>

                @if (TempData["UploadError"] != null)
                {
                    <div class="p-2.5 rounded-lg bg-error/10 text-error text-xs border border-error/20">
                        @TempData["UploadError"]
                    </div>
                }

                @if (!Model.Attachments.Any())
                {
                    <div class="py-4 text-center text-xs text-on-surface-variant">
                        Henüz yüklenmiş kanıt veya dosya eki bulunmuyor.
                    </div>
                }
                else
                {
                    <div class="flex flex-col gap-2">
                        @foreach (var attachment in Model.Attachments)
                        {
                            <div class="flex items-center justify-between p-3 rounded-lg bg-surface-container/60 border border-white/[0.04] hover:border-white/20 transition-all group">
                                <div class="flex items-center gap-3 min-w-0">
                                    <span class="material-symbols-outlined text-secondary text-[1.25rem] shrink-0">description</span>
                                    <div class="flex flex-col min-w-0">
                                        <a asp-action="Attachment" asp-route-id="@attachment.Id" target="_blank" rel="noopener"
                                           class="text-xs font-medium text-white truncate hover:underline hover:text-primary">
                                            @attachment.FileName
                                        </a>
                                        <span class="text-[10px] text-outline font-mono">
                                            @(attachment.UploadedByUser?.FullName ?? "Personel") · @attachment.UploadedAt.ToLocalTime().ToString("dd.MM.yyyy")
                                        </span>
                                    </div>
                                </div>
                                <a asp-action="Attachment" asp-route-id="@attachment.Id" asp-route-download="true"
                                   class="text-outline group-hover:text-primary transition-colors p-1" title="İndir">
                                    <span class="material-symbols-outlined text-[1.125rem]">download</span>
                                </a>
                            </div>
                        }
                    </div>
                }

                <!-- Clean upload form -->
                <form asp-action="UploadAttachment" asp-controller="Dofs" method="post" enctype="multipart/form-data" class="mt-1 flex flex-col gap-2">
                    <input type="hidden" name="dofId" value="@Model.Id" />
                    <input type="file" name="file" id="attachment-input" required
                           class="w-full text-xs text-outline file:mr-2 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-medium file:bg-surface-container-high file:text-primary hover:file:bg-primary hover:file:text-surface transition-colors cursor-pointer" />
                    <button type="submit" class="w-full py-2 px-3 border border-dashed border-white/[0.12] hover:border-primary/40 rounded-lg text-center text-xs text-outline hover:text-primary transition-all flex items-center justify-center gap-2 cursor-pointer">
                        <span class="material-symbols-outlined text-[1rem]">cloud_upload</span>
                        <span>Yeni Dosya Yükle</span>
                    </button>
                </form>
            </section>
        </aside>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var respSelect = document.getElementById('inline-action-responsible');
            if (!respSelect) return;
            fetch('@Url.Action("DepartmentUsers", "DofActions")?dofId=@Model.Id')
                .then(function (r) { return r.ok ? r.json() : []; })
                .then(function (list) {
                    list.forEach(function (u) {
                        var o = document.createElement('option');
                        o.value = u.id;
                        o.textContent = u.fullName;
                        respSelect.appendChild(o);
                    });
                })
                .catch(function () {});
        })();
    </script>
}